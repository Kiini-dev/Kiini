{
  "name": "kiini-one-hub-total-control",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "cross-env NODE_ENV=development PORT=3005 tsx watch server/_core/bootstrap.ts",
    "build": "vite build && esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist && esbuild server/jobs/scheduledJobRunner.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/scheduled-jobs.js",
    "build:with-seed": "pnpm build && pnpm seed:default-user",
    "start": "NODE_ENV=production node app.js",
    "jobs:run": "node scripts/run-scheduled-job.mjs",
    "start:with-seed": "pnpm db:push && pnpm seed:default-user && pnpm start",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:coverage": "vitest run --coverage",
    "test:reports": "tsx scripts/test-reports.ts",
    "db:push:auto": "tsx scripts/auto-db-push.ts",
    "db:generate": "tsx drizzle-migrate.ts generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:migrate:manual": "node apply-missing-columns.mjs",
    "db:audit": "tsx scripts/audit-schema.ts",
    "db:push": "pnpm db:generate && pnpm db:migrate",
    "seed": "tsx scripts/seed.ts",
    "seed:default-user": "tsx scripts/seed-default-user.ts",
    "seed:default-user:node": "node scripts/seed-default-user.mjs",
    "seed:email-templates": "node scripts/seed-email-templates.mjs",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:all": "pnpm db:push && pnpm seed:default-user && pnpm seed",
    "db:health": "node database-health-check.js",
    "db:setup": "node setup-database.js",
    "db:diagnose": "node database-health-check.js && echo '' && node setup-database.js",
    "permissions:sync": "tsx scripts/sync-permissions.ts"
  },
