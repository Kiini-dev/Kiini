`;
    txt += `${"-".repeat(25)} | ${"-".repeat(15)} | ${"-".repeat(15)} | ${"-".repeat(12)} | ${"-".repeat(10)}
`;
    data.expenseData.slice(0, 50).forEach((exp) => {
      const desc86 = (exp.description || "N/A").substring(0, 24).padEnd(25);
