async function resolveTemplate(templateId, variables, fallback) {
  try {
    const database2 = await getDb();
    if (!database2) return fallback;
    const rows = await database2.select().from(settings).where(eq49(settings.category, `email_template:${templateId}`));
    if (!rows.length) return fallback;
    const saved = {};
    rows.forEach((r) => {
      if (r.key) saved[r.key] = r.value ?? "";
    });
    if (!saved.subject && !saved.body) return fallback;
    let subject = saved.subject || fallback.subject;
    let html = saved.body || fallback.html;
    const sigRows = await database2.select().from(settings).where(eq49(settings.category, "email_template:email-signature-all"));
    const footerRows = await database2.select().from(settings).where(eq49(settings.category, "email_template:email-footer-all"));
    const sigBody = sigRows.find((r) => r.key === "body")?.value || "";
    const footerBody = footerRows.find((r) => r.key === "body")?.value || "";
    variables.email_signature = replaceVars(sigBody, variables);
    variables.email_footer = replaceVars(footerBody, variables);
    variables.todays_date = variables.todays_date || (/* @__PURE__ */ new Date()).toLocaleDateString();
    subject = replaceVars(subject, variables);
    html = replaceVars(html, variables);
    const wrappedHtml = `<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; color: #333;">${html}${variables.email_signature ? `<div>${variables.email_signature}</div>` : ""}${variables.email_footer ? `<hr style="border: none; border-top: 1px solid #ddd; margin: 30px 0;"><div>${variables.email_footer}</div>` : ""}</div>`;
    const text3 = wrappedHtml.replace(/<[^>]+>/g, "").replace(/\s+/g, " ").trim();
    return { subject, html: wrappedHtml, text: text3 };
  } catch {
    return fallback;
  }
}
function replaceVars(template, vars) {
  return template.replace(/\{(\w+)\}/g, (match, key) => vars[key] ?? match);
}
async function getCompanyName() {
  try {
    const info = await getCompanyInfo();
    return info.name;
  } catch {
    return process.env.COMPANY_NAME || "Your Company";
  }
}
