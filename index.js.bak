         FROM employees e
         WHERE e.status = 'active' AND e.basic_salary > 0`
    );
    let generated = 0;
    for (const emp of employees5) {
      const basic = parseFloat(emp.basic_salary) || 0;
      if (basic <= 0) continue;
      const nhif = basic <= 5999 ? 150 : basic <= 7999 ? 300 : basic <= 11999 ? 400 : basic <= 14999 ? 500 : basic <= 19999 ? 600 : basic <= 24999 ? 750 : basic <= 29999 ? 850 : basic <= 34999 ? 900 : basic <= 39999 ? 950 : basic <= 44999 ? 1e3 : basic <= 49999 ? 1100 : basic <= 59999 ? 1200 : basic <= 69999 ? 1300 : basic <= 79999 ? 1400 : basic <= 89999 ? 1500 : basic <= 99999 ? 1600 : 1700;
