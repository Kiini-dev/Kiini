        if (!wb.Workbook) wb.Workbook = { Sheets: [] };
        if (!wb.Workbook.Names) wb.Workbook.Names = [];
        var names = wb.Workbook.Names;
        var range = decode_range(ref);
        if (range.s.r == range.e.r) {
          range.e.r = decode_range(ws["!ref"]).e.r;
