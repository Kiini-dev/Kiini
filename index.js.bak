        // e.g. 2024, 2025
        budgetedAmount: int2("budgetedAmount").notNull(),
        // in cents
        spent: int2("spent").default(0).notNull(),
        // in cents
        remaining: int2("remaining").notNull(),
        // in cents
        budgetStatus: mysqlEnum2("budgetStatus", ["under", "at", "over"]).notNull(),
        category: varchar2("category", { length: 100 }),
        // e.g. payroll, operations, marketing
        notes: text2("notes"),
