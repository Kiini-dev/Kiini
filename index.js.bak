// server/routers/reports.ts
init_trpc();
init_zod();
init_db();
init_schema();
import { eq as eq50, and as and45, gte as gte9, lte as lte9 } from "drizzle-orm";
var reportsRouter = router({
  // Profit & Loss Report
  profitAndLoss: createFeatureRestrictedProcedure2("reporting:view").input(external_exports.object({
    startDate: external_exports.date(),
    endDate: external_exports.date()
  })).query(async ({ input }) => {
    const database2 = await getDb();
    if (!database2) return null;
    const revenueAccounts = await database2.select().from(accounts).where(and45(
      eq50(accounts.accountType, "revenue"),
      eq50(accounts.isActive, 1)
    ));
    const expenseAccounts = await database2.select().from(accounts).where(and45(
      eq50(accounts.accountType, "expense"),
      eq50(accounts.isActive, 1)
    ));
    const totalRevenue = revenueAccounts.reduce((sum5, a) => sum5 + (a.balance || 0), 0);
    const totalExpenses = expenseAccounts.reduce((sum5, a) => sum5 + (a.balance || 0), 0);
    const netIncome = totalRevenue - totalExpenses;
    return {
      period: {
        startDate: input.startDate,
        endDate: input.endDate
      },
      revenue: {
        accounts: revenueAccounts,
        total: totalRevenue
      },
      expenses: {
        accounts: expenseAccounts,
        total: totalExpenses
      },
      netIncome,
      netIncomePercentage: totalRevenue > 0 ? netIncome / totalRevenue * 100 : 0
    };
  }),
  // Balance Sheet Report
  balanceSheet: createFeatureRestrictedProcedure2("reporting:view").query(async () => {
    const database2 = await getDb();
    if (!database2) return null;
    const assetAccounts = await database2.select().from(accounts).where(and45(
      eq50(accounts.accountType, "asset"),
      eq50(accounts.isActive, 1)
    ));
    const liabilityAccounts = await database2.select().from(accounts).where(and45(
      eq50(accounts.accountType, "liability"),
      eq50(accounts.isActive, 1)
    ));
    const equityAccounts = await database2.select().from(accounts).where(and45(
      eq50(accounts.accountType, "equity"),
      eq50(accounts.isActive, 1)
    ));
    const totalAssets = assetAccounts.reduce((sum5, a) => sum5 + (a.balance || 0), 0);
    const totalLiabilities = liabilityAccounts.reduce((sum5, a) => sum5 + (a.balance || 0), 0);
    const totalEquity = equityAccounts.reduce((sum5, a) => sum5 + (a.balance || 0), 0);
    return {
      assets: {
        accounts: assetAccounts,
        total: totalAssets
      },
      liabilities: {
        accounts: liabilityAccounts,
        total: totalLiabilities
      },
      equity: {
        accounts: equityAccounts,
        total: totalEquity
      },
      totalLiabilitiesAndEquity: totalLiabilities + totalEquity,
      balanced: Math.abs(totalAssets - (totalLiabilities + totalEquity)) < 0.01
    };
  }),
  // Sales Report
  salesReport: createFeatureRestrictedProcedure2("reporting:view").input(external_exports.object({
    startDate: external_exports.date(),
    endDate: external_exports.date(),
    groupBy: external_exports.enum(["day", "week", "month"]).default("month")
  })).query(async ({ input }) => {
    const database2 = await getDb();
    if (!database2) return null;
    const invoiceData = await database2.select().from(invoices).where(and45(
      gte9(invoices.issueDate, input.startDate.toISOString().replace("T", " ").substring(0, 19)),
      lte9(invoices.issueDate, input.endDate.toISOString().replace("T", " ").substring(0, 19))
    ));
    const clientsData = await database2.select().from(clients);
    const salesByClient = {};
    invoiceData.forEach((inv) => {
      const client = clientsData.find((c) => c.id === inv.clientId);
      const clientName = client?.companyName || "Unknown";
      if (!salesByClient[clientName]) {
        salesByClient[clientName] = {
          clientId: inv.clientId,
          clientName,
          invoiceCount: 0,
          totalSales: 0,
          paidAmount: 0,
          pendingAmount: 0
        };
      }
      salesByClient[clientName].invoiceCount++;
      salesByClient[clientName].totalSales += inv.total || 0;
      salesByClient[clientName].paidAmount += inv.paidAmount || 0;
      salesByClient[clientName].pendingAmount += (inv.total || 0) - (inv.paidAmount || 0);
    });
    const totalSales = Object.values(salesByClient).reduce((sum5, s) => sum5 + s.totalSales, 0);
    const totalPaid = Object.values(salesByClient).reduce((sum5, s) => sum5 + s.paidAmount, 0);
    const totalPending = Object.values(salesByClient).reduce((sum5, s) => sum5 + s.pendingAmount, 0);
    return {
      period: {
        startDate: input.startDate,
        endDate: input.endDate
      },
      summary: {
        totalInvoices: invoiceData.length,
        totalSales,
        totalPaid,
        totalPending,
        collectionRate: totalSales > 0 ? totalPaid / totalSales * 100 : 0
      },
      byClient: Object.values(salesByClient),
      byStatus: {
        paid: invoiceData.filter((i) => i.status === "paid").length,
        pending: invoiceData.filter((i) => i.status === "sent").length,
        overdue: invoiceData.filter((i) => i.status === "overdue").length,
        draft: invoiceData.filter((i) => i.status === "draft").length
      }
    };
  }),
  // Cash Flow Report
  cashFlowReport: createFeatureRestrictedProcedure2("reporting:view").input(external_exports.object({
    startDate: external_exports.date(),
    endDate: external_exports.date()
  })).query(async ({ input }) => {
    const database2 = await getDb();
    if (!database2) return null;
    const paymentData = await database2.select().from(payments).where(and45(
      gte9(payments.paymentDate, input.startDate.toISOString().replace("T", " ").substring(0, 19)),
      lte9(payments.paymentDate, input.endDate.toISOString().replace("T", " ").substring(0, 19))
    ));
    const expenseData = await database2.select().from(expenses).where(and45(
      gte9(expenses.expenseDate, input.startDate.toISOString().replace("T", " ").substring(0, 19)),
      lte9(expenses.expenseDate, input.endDate.toISOString().replace("T", " ").substring(0, 19))
    ));
    const totalInflow = paymentData.reduce((sum5, p) => sum5 + (p.amount || 0), 0);
