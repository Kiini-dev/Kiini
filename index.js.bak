      }).from(expenses).groupBy(expenses.category);
      return metrics;
    } catch (error48) {
      console.error("Expense metrics error:", error48);
      return [];
    }
  }),
  /**
   * Get top clients by revenue
   */
  topClients: createFeatureRestrictedProcedure2("analytics:view").input(
    external_exports.object({
      limit: external_exports.number().default(10)
    })
  ).query(async ({ input }) => {
    const db = await getDb();
    if (!db) return [];
    try {
      const topClients = await db.select({
        clientId: invoices.clientId,
        clientName: clients.companyName,
        totalRevenue: sum2(invoices.total).as("totalRevenue"),
        invoiceCount: count4().as("invoiceCount")
      }).from(invoices).leftJoin(clients, eq58(invoices.clientId, clients.id)).groupBy(invoices.clientId).orderBy((t2) => t2.totalRevenue).limit(input.limit);
      return topClients;
    } catch (error48) {
      console.error("Top clients error:", error48);
      return [];
    }
  }),
  /**
   * Get payment method distribution
   */
  paymentMethodDistribution: createFeatureRestrictedProcedure2("analytics:view").query(async () => {
    const db = await getDb();
    if (!db) return [];
    try {
      const distribution = await db.select({
        method: payments.paymentMethod,
        count: count4().as("count"),
        total: sum2(payments.amount).as("total")
      }).from(payments).groupBy(payments.paymentMethod);
      return distribution;
    } catch (error48) {
      console.error("Payment method distribution error:", error48);
      return [];
    }
  }),
  /**
   * Get monthly comparison data
   */
  monthlyComparison: createFeatureRestrictedProcedure2("analytics:view").input(
    external_exports.object({
      currentMonth: external_exports.string(),
      previousMonth: external_exports.string()
    })
  ).query(async ({ input }) => {
    const db = await getDb();
    if (!db) return null;
    try {
      const currentMonthData = await db.select({
        total: sum2(invoices.total).as("total"),
        count: count4().as("count")
      }).from(invoices).where(
        and49(
          gte10(invoices.issueDate, input.currentMonth),
          lte10(invoices.issueDate, input.currentMonth)
        )
      );
      const previousMonthData = await db.select({
        total: sum2(invoices.total).as("total"),
        count: count4().as("count")
      }).from(invoices).where(
        and49(
          gte10(invoices.issueDate, input.previousMonth),
          lte10(invoices.issueDate, input.previousMonth)
        )
      );
      const current = currentMonthData[0] || { total: 0, count: 0 };
      const previous = previousMonthData[0] || { total: 0, count: 0 };
      const currentTotal = parseFloat(current.total || "0");
      const previousTotal = parseFloat(previous.total || "0");
      const percentChange = previousTotal > 0 ? (currentTotal - previousTotal) / previousTotal * 100 : 0;
      return {
        currentMonth: {
          total: currentTotal,
          count: current.count
        },
        previousMonth: {
          total: previousTotal,
          count: previous.count
        },
        percentChange,
        trend: currentTotal > previousTotal ? "up" : "down"
      };
    } catch (error48) {
      console.error("Monthly comparison error:", error48);
      return null;
    }
  }),
  /**
   * Get KPI summary
   */
  kpiSummary: createFeatureRestrictedProcedure2("analytics:view").query(async () => {
    const db = await getDb();
    if (!db) return null;
    try {
      const invoiceData = await db.select({
        total: sum2(invoices.total).as("total"),
        count: count4().as("count")
      }).from(invoices);
      const paidData = await db.select({
        total: sum2(invoices.total).as("total")
      }).from(invoices).where(eq58(invoices.status, "paid"));
      const overdueData = await db.select({
        total: sum2(invoices.total).as("total"),
        count: count4().as("count")
      }).from(invoices).where(eq58(invoices.status, "overdue"));
      const activeProjects = await db.select({
        count: count4().as("count")
      }).from(projects).where(eq58(projects.status, "active"));
      const activeClients = await db.select({
        count: count4().as("count")
      }).from(clients).where(eq58(clients.status, "active"));
      const invoiceTotal = parseFloat(invoiceData[0]?.total || "0");
      const paidTotal = parseFloat(paidData[0]?.total || "0");
      return {
        totalInvoiced: invoiceTotal,
        totalInvoiceCount: invoiceData[0]?.count || 0,
        totalPaid: paidTotal,
        totalOutstanding: invoiceTotal - paidTotal,
        overdueAmount: parseFloat(overdueData[0]?.total || "0"),
        overdueCount: overdueData[0]?.count || 0,
        activeProjects: activeProjects[0]?.count || 0,
        activeClients: activeClients[0]?.count || 0
      };
    } catch (error48) {
      console.error("KPI summary error:", error48);
      return null;
    }
  })
});

