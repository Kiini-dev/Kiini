async function generateNextExpenseNumber2(database2) {
  try {
    const result = await database2.select({ expNum: expenses.expenseNumber }).from(expenses).orderBy(desc14(expenses.expenseNumber)).limit(1);
    let maxSequence = 0;
    if (result && result.length > 0 && result[0].expNum) {
      const match = result[0].expNum.match(/(\d+)$/);
      if (match) {
        maxSequence = parseInt(match[1]);
      }
    }
    const nextSequence = maxSequence + 1;
    return `EXP-${String(nextSequence).padStart(6, "0")}`;
  } catch (err) {
    console.warn("Error generating expense number, using default:", err);
    return `EXP-000001`;
  }
}
async function updateCOABalance(database2, chartOfAccountId, amount, operation) {
  if (!chartOfAccountId) return;
  try {
    const coa = await database2.select().from(accounts).where(eq36(accounts.id, chartOfAccountId.toString())).limit(1);
    if (!coa.length) return;
    const currentBalance = coa[0].balance || 0;
    const newBalance = operation === "add" ? currentBalance + amount : currentBalance - amount;
    await database2.update(accounts).set({ balance: newBalance }).where(eq36(accounts.id, chartOfAccountId.toString()));
  } catch (error48) {
    console.error("Error updating COA balance:", error48);
  }
}
