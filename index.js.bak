function calculateHealthStatus(cpuLoad, memUsage, diskUsage) {
  if (cpuLoad > 90 || memUsage > 90 || diskUsage > 95) {
    return "critical";
  }
  if (cpuLoad > 75 || memUsage > 80 || diskUsage > 85) {
    return "warning";
  }
  return "healthy";
}
async function getSystemHealthForAlerts() {
  try {
    const totalMem = os2.totalmem();
    const freeMem = os2.freemem();
    const memUsage = (totalMem - freeMem) / totalMem * 100;
    const cpus = os2.cpus();
    const cpuLoad = cpus.reduce((acc, cpu) => {
      const total = Object.values(cpu.times).reduce((a, b) => a + b, 0);
      const idle = cpu.times.idle;
      return acc + (total - idle) / total * 100;
    }, 0) / cpus.length;
    return {
      cpuLoad: Math.round(cpuLoad),
      memoryUsage: Math.round(memUsage),
      diskUsage: 45
    };
  } catch (error48) {
    console.error("Error getting system health for alerts:", error48);
    return {
      cpuLoad: 0,
      memoryUsage: 0,
      diskUsage: 0
    };
  }
}
async function logAuditEvent(db, event) {
  try {
    await db.insert(auditLogs).values({
      id: `audit_${Date.now()}`,
      action: event.action,
      userId: event.userId,
      organizationId: event.organizationId,
      details: event.details,
      ipAddress: event.ipAddress,
      createdAt: (/* @__PURE__ */ new Date()).toISOString()
    });
  } catch (error48) {
    console.error("Error logging audit event:", error48);
  }
}

