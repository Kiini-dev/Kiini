async function generateExpenseReportPDF(config2) {
  const db = await getDb();
  if (!db) {
    throw new Error("Database connection not available");
  }
  let expensesQuery = db.select().from(expenses);
  if (config2.startDate) {
    expensesQuery = expensesQuery.where(gte11(expenses.expenseDate, config2.startDate));
  }
  if (config2.endDate) {
    expensesQuery = expensesQuery.where(lte11(expenses.expenseDate, config2.endDate));
  }
  const expenseData = await expensesQuery;
  const totalExpenses = expenseData.reduce((sum5, exp) => sum5 + (exp.amount || 0), 0);
  const expensesByCategory = {};
  expenseData.forEach((exp) => {
    const category = exp.category || "Uncategorized";
    expensesByCategory[category] = (expensesByCategory[category] || 0) + (exp.amount || 0);
  });
  const doc = new import_jspdf2.jsPDF();
  doc.setFont("helvetica");
  const companyInfo = await getCompanyInfo();
  doc.setFontSize(20);
  doc.setFont("helvetica", "bold");
  doc.setTextColor(40, 40, 40);
  doc.text(companyInfo.name, 20, 20);
  doc.setFontSize(10);
  doc.setFont("helvetica", "normal");
  doc.setTextColor(100, 100, 100);
  doc.text("Expense Report", 20, 28);
  doc.setFontSize(16);
  doc.setFont("helvetica", "bold");
  doc.setTextColor(40, 40, 40);
  doc.text(config2.title, 20, 40);
  doc.setFontSize(10);
  doc.setFont("helvetica", "normal");
  doc.setTextColor(100, 100, 100);
  const periodText = config2.startDate && config2.endDate ? `Period: ${config2.startDate.toLocaleDateString()} - ${config2.endDate.toLocaleDateString()}` : "Period: All Time";
  doc.text(periodText, 20, 48);
  doc.text(`Generated: ${(/* @__PURE__ */ new Date()).toLocaleDateString()}`, 20, 54);
  doc.setFontSize(12);
  doc.setFont("helvetica", "bold");
  doc.setTextColor(40, 40, 40);
  doc.text("Expense Summary", 20, 70);
  const formatCurrency2 = (amount) => {
    return new Intl.NumberFormat("en-KE", {
      style: "currency",
      currency: "KES"
    }).format(amount / 100);
  };
  const summaryData = [
    ["Total Expenses", formatCurrency2(totalExpenses)],
    ["Number of Expenses", String(expenseData.length)],
    ["Average Expense", expenseData.length > 0 ? formatCurrency2(totalExpenses / expenseData.length) : "Ksh 0"]
  ];
  autoTable(doc, {
    startY: 76,
    head: [["Metric", "Amount"]],
    body: summaryData,
    theme: "grid",
    headStyles: {
      fillColor: [40, 40, 40],
      textColor: [255, 255, 255],
      fontStyle: "bold",
      fontSize: 10
    },
    bodyStyles: {
      fontSize: 10
    },
    columnStyles: {
      0: { cellWidth: 120 },
      1: { cellWidth: 70, halign: "right" }
    }
  });
  if (config2.includeDetails && Object.keys(expensesByCategory).length > 0) {
    const currentY = doc.lastAutoTable.finalY + 10;
    doc.setFontSize(12);
    doc.setFont("helvetica", "bold");
    doc.setTextColor(40, 40, 40);
    doc.text("Expenses by Category", 20, currentY);
    const categoryTableData = Object.entries(expensesByCategory).map(([category, amount]) => [
      category,
      formatCurrency2(amount),
      totalExpenses > 0 ? `${(amount / totalExpenses * 100).toFixed(1)}%` : "0%"
    ]);
    autoTable(doc, {
      startY: currentY + 6,
      head: [["Category", "Amount", "Percentage"]],
      body: categoryTableData,
      theme: "grid",
      headStyles: {
        fillColor: [50, 50, 50],
        textColor: [255, 255, 255],
        fontStyle: "bold",
        fontSize: 9
      },
      bodyStyles: {
        fontSize: 8
      },
      columnStyles: {
        0: { cellWidth: 80 },
        1: { cellWidth: 50, halign: "right" },
        2: { cellWidth: 30, halign: "right" }
      }
    });
  }
  const pageCount = doc.internal.pages.length - 1;
  for (let i = 1; i <= pageCount; i++) {
    doc.setPage(i);
    doc.setFontSize(8);
    doc.setTextColor(150, 150, 150);
    doc.text(`Page ${i} of ${pageCount}`, doc.internal.pageSize.getWidth() - 20, doc.internal.pageSize.getHeight() - 10);
    doc.text("Confidential - For Authorized Use Only", 20, doc.internal.pageSize.getHeight() - 10);
  }
  return Buffer.from(doc.output("arraybuffer"));
}

// server/utils/report-export-utils.ts
init_db();
init_schema();
init_company_info();
import { gte as gte12, lte as lte12 } from "drizzle-orm";
async function fetchFinancialData(config2) {
  const db = await getDb();
  if (!db) {
    throw new Error("Database connection not available");
  }
  try {
    let invoicesQuery = db.select({
      id: invoices.id,
      invoiceNumber: invoices.invoiceNumber,
      total: invoices.total,
      paidAmount: invoices.paidAmount,
      status: invoices.status,
      issueDate: invoices.issueDate
    }).from(invoices);
    let expensesQuery = db.select({
      id: expenses.id,
      amount: expenses.amount,
      expenseDate: expenses.expenseDate,
      status: expenses.status
    }).from(expenses);
    if (config2.startDate) {
      invoicesQuery = invoicesQuery.where(gte12(invoices.issueDate, config2.startDate));
      expensesQuery = expensesQuery.where(gte12(expenses.expenseDate, config2.startDate));
    }
    if (config2.endDate) {
      invoicesQuery = invoicesQuery.where(lte12(invoices.issueDate, config2.endDate));
      expensesQuery = expensesQuery.where(lte12(expenses.expenseDate, config2.endDate));
    }
    const invoiceData = await invoicesQuery;
    const expenseData = await expensesQuery;
    const totalInvoiced = invoiceData.reduce((sum5, inv) => sum5 + (inv.total || 0), 0);
    const paidInvoices = invoiceData.filter((inv) => inv.status === "paid").reduce((sum5, inv) => sum5 + (inv.total || 0), 0);
    const outstandingAmount = invoiceData.reduce((sum5, inv) => sum5 + ((inv.total || 0) - (inv.paidAmount || 0)), 0);
    const totalExpenses = expenseData.reduce((sum5, exp) => sum5 + (exp.amount || 0), 0);
    const netProfit = totalInvoiced - totalExpenses;
    return {
      invoiceData,
      expenseData,
      totalInvoiced,
      paidInvoices,
      outstandingAmount,
      totalExpenses,
      netProfit
    };
  } catch (error48) {
    console.error("Error fetching financial data:", error48);
    throw new Error(`Failed to fetch financial data: ${error48 instanceof Error ? error48.message : "Unknown error"}`);
  }
}
var formatCurrency = (amount) => {
  return new Intl.NumberFormat("en-KE", {
    style: "currency",
    currency: "KES"
  }).format(amount / 100);
};
async function generateFinancialReportCSV(config2) {
  const data = await fetchFinancialData(config2);
  const companyInfo = await getCompanyInfo();
  let csv = "";
  csv += `${companyInfo.name} - Financial Report
`;
  csv += `Report: ${config2.title}
`;
  const periodText = config2.startDate && config2.endDate ? `Period: ${config2.startDate.toLocaleDateString()} - ${config2.endDate.toLocaleDateString()}` : "Period: All Time";
  csv += `${periodText}
`;
  csv += `Generated: ${(/* @__PURE__ */ new Date()).toLocaleDateString()}
`;
  csv += "\n";
  csv += "FINANCIAL SUMMARY\n";
  csv += "Metric,Amount\n";
  csv += `Total Revenue,"${formatCurrency(data.totalInvoiced)}"
`;
  csv += `Paid Invoices,"${formatCurrency(data.paidInvoices)}"
`;
  csv += `Outstanding Receivables,"${formatCurrency(data.outstandingAmount)}"
`;
  csv += `Total Expenses,"${formatCurrency(data.totalExpenses)}"
`;
  csv += `Net Profit,"${formatCurrency(data.netProfit)}"
`;
  csv += "\n";
  if (config2.includeDetails && data.invoiceData.length > 0) {
    csv += "INVOICE DETAILS\n";
    csv += "Invoice #,Client,Date,Amount,Status\n";
    data.invoiceData.forEach((inv) => {
      csv += `"${inv.invoiceNumber || "N/A"}","Client ${inv.clientId ? inv.clientId.substring(0, 8) : "N/A"}","${new Date(inv.issueDate).toLocaleDateString()}","${formatCurrency(inv.total || 0)}","${inv.status || "pending"}"
`;
    });
    csv += "\n";
  }
  if (config2.includeDetails && data.expenseData.length > 0) {
    csv += "EXPENSE DETAILS\n";
    csv += "Description,Category,Amount,Date,Status\n";
    data.expenseData.forEach((exp) => {
      csv += `"${exp.description || "N/A"}","${exp.category || "N/A"}","${formatCurrency(exp.amount || 0)}","${new Date(exp.expenseDate).toLocaleDateString()}","${exp.status || "pending"}"
`;
    });
  }
  return Buffer.from(csv, "utf-8");
}
