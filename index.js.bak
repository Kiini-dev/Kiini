async function removeOrgSubscriptionJobs(orgId) {
  const pool12 = getPool();
  const patterns = [
    `org_trial_expiry_${orgId}`,
    `org_renewal_${orgId}`,
    `org_payment_reminder_${orgId}`,
    `org_usage_monitor_${orgId}`,
    `org_billing_invoice_${orgId}`
  ];
  let removed = 0;
  for (const jobName of patterns) {
    const [result] = await pool12.query(`DELETE FROM scheduledJobs WHERE jobName = ?`, [jobName]);
    removed += result.affectedRows || 0;
  }
  console.log(`[OrgSubscription] Removed ${removed} jobs for org ${orgId}`);
  return removed;
}

