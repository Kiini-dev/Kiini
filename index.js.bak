  adjustStock: publicProcedure.input(stockAdjustmentSchema).mutation(async ({ ctx: ctx2, input }) => {
    try {
      const database2 = await getDb();
      if (!database2) {
        throw new TRPCError2({ code: "INTERNAL_SERVER_ERROR", message: "Database connection failed" });
      }
      const product = await database2.select().from(products).where(eq83(products.id, input.productId)).limit(1).then((result) => result[0] || null).catch(() => null);
      if (!product) {
        throw new TRPCError2({
          code: "NOT_FOUND",
          message: "Product not found"
        });
      }
      const newQuantity = Math.max(0, (product.stockQuantity || 0) + input.quantityChange);
      await database2.update(products).set({
        stockQuantity: newQuantity,
        updatedAt: (/* @__PURE__ */ new Date()).toISOString().replace("T", " ").substring(0, 19).split("T")[0]
      }).where(eq83(products.id, input.productId));
      await logActivity({
        userId: ctx2.user?.id || "system",
        action: "stock_adjusted",
        description: `Stock adjusted by ${input.quantityChange} units (${input.reason})`,
        entityType: "product",
        entityId: input.productId
      });
      return {
        success: true,
        productId: product.id,
        productName: product.name,
        oldQuantity: product.stockQuantity || 0,
