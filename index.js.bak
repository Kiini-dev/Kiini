  create: publicProcedure.input(inventoryCreateSchema).mutation(async ({ ctx: ctx2, input }) => {
    try {
      const database2 = await getDb();
      if (!database2) {
        throw new TRPCError2({ code: "INTERNAL_SERVER_ERROR", message: "Database connection failed" });
      }
      await database2.update(products).set({
        stockQuantity: input.quantity,
        reorderPoint: input.reorderLevel,
        unitPrice: input.unitCost,
        updatedAt: (/* @__PURE__ */ new Date()).toISOString().replace("T", " ").substring(0, 19).split("T")[0]
      }).where(eq83(products.id, input.productId));
      const updated = await database2.select().from(products).where(eq83(products.id, input.productId)).limit(1).then((result) => result[0] || null).catch(() => null);
      if (!updated) {
        throw new TRPCError2({
          code: "NOT_FOUND",
          message: "Product not found"
        });
      }
      await logActivity({
        userId: ctx2.user?.id || "system",
