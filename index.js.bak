  // ── Pricing Tier Features ──────────────────────────────────────
  getPricingTierFeatures: enterpriseViewProcedure.input(external_exports.object({ tier: external_exports.string() })).query(async ({ input }) => {
    const features = await getPricingTierFeatures(input.tier);
    const featureMap = {};
    features.forEach((f) => {
      featureMap[f.featureKey] = Boolean(f.isEnabled);
    });
    return { features: featureMap, rawFeatures: features };
  }),
  getAllPricingTierFeatures: enterpriseViewProcedure.query(async () => {
    const all3 = await getAllPricingTierFeatures();
    const byTier = {};
    all3.forEach((f) => {
      if (!byTier[f.tier]) byTier[f.tier] = {};
      byTier[f.tier][f.featureKey] = Boolean(f.isEnabled);
    });
    return { tiers: byTier };
  }),
  setPricingTierFeature: enterpriseEditProcedure.input(external_exports.object({ tier: external_exports.string(), featureKey: external_exports.string(), isEnabled: external_exports.boolean() })).mutation(async ({ input }) => {
    await setPricingTierFeature(input.tier, input.featureKey, input.isEnabled);
    return { success: true };
  }),
  bulkSetPricingTierFeatures: enterpriseEditProcedure.input(external_exports.object({
    tier: external_exports.string(),
    features: external_exports.record(external_exports.string(), external_exports.boolean())
  })).mutation(async ({ input }) => {
    await bulkSetPricingTierFeatures(input.tier, input.features);
    return { success: true };
  }),
  applyTierToOrganization: enterpriseEditProcedure.input(external_exports.object({ organizationId: external_exports.string(), tier: external_exports.string() })).mutation(async ({ input, ctx: ctx2 }) => {
    if (!checkOrgScopeAccess(ctx2, input.organizationId)) {
      throw new TRPCError2({ code: "FORBIDDEN", message: "You can only modify your own organization" });
    }
    const org = await getOrganization(input.organizationId);
    if (!org) throw new TRPCError2({ code: "NOT_FOUND" });
    let featuresToApply;
    const tierFeatures = await getPricingTierFeatures(input.tier);
    if (tierFeatures.length > 0) {
      featuresToApply = {};
      tierFeatures.forEach((tf) => {
        featuresToApply[tf.featureKey] = Boolean(tf.isEnabled);
      });
    } else {
      featuresToApply = TIER_DEFAULT_FEATURES[input.tier] ?? TIER_DEFAULT_FEATURES["trial"];
    }
    await Promise.all(
      Object.entries(featuresToApply).map(
        ([key, enabled]) => setOrganizationFeature(input.organizationId, key, enabled)
      )
    );
    await updateOrganization(input.organizationId, { plan: input.tier });
    try {
      const oldPlan = org.plan || "trial";
      await updateOrgSubscriptionJobs(input.organizationId, org.name || "Organization", oldPlan, input.tier);
    } catch (jobError) {
      console.error("[MultiTenancy] Failed to update subscription jobs:", jobError);
    }
    return { success: true, featuresApplied: Object.keys(featuresToApply).length };
  }),
  /**
   * Seeds the pricingTierFeatures table with default values for all tiers.
   * Safe to call multiple times — only inserts missing entries, does not override existing ones.
   */
  seedDefaultTierFeatures: enterpriseEditProcedure.mutation(async () => {
    const existing = await getAllPricingTierFeatures();
    const existingSet = new Set(existing.map((f) => `${f.tier}:${f.featureKey}`));
    let seeded = 0;
    for (const [tier, features] of Object.entries(TIER_DEFAULT_FEATURES)) {
      for (const [featureKey, isEnabled] of Object.entries(features)) {
        if (!existingSet.has(`${tier}:${featureKey}`)) {
          await setPricingTierFeature(tier, featureKey, isEnabled);
          seeded++;
        }
      }
    }
    return { success: true, seeded };
  }),
  // ── Tenant Communications ──────────────────────────────────────
  sendTenantMessage: enterpriseEditProcedure.input(external_exports.object({
    subject: external_exports.string(),
    content: external_exports.string(),
    priority: external_exports.string().optional(),
    targetType: external_exports.string().optional(),
    targetOrgId: external_exports.string().optional(),
    targetUserId: external_exports.string().optional()
  })).mutation(async ({ input, ctx: ctx2 }) => {
    const id = `tmsg_${v4_default().replace(/-/g, "").slice(0, 20)}`;
    const msg = await createTenantMessage({
      id,
      senderId: ctx2.user?.id ?? "system",
      subject: input.subject,
      content: input.content,
      priority: input.priority ?? "normal",
      targetType: input.targetType ?? "all",
      targetOrgId: input.targetOrgId ?? null,
      targetUserId: input.targetUserId ?? null
    });
    if (input.targetOrgId) {
      const database2 = await getDb();
      if (database2) {
        const { communicationLogs: communicationLogs3 } = await Promise.resolve().then(() => (init_schema(), schema_exports));
        const orgUsers = await getUsersByOrganization(input.targetOrgId);
        const recipientEmails = orgUsers.filter((u) => !!u.email).map((u) => u.email).slice(0, 20).join(", ");
        await database2.insert(communicationLogs3).values({
          id: `com_${Date.now()}_${Math.random().toString(36).slice(2, 7)}`,
          organizationId: input.targetOrgId,
          type: "email",
          recipient: recipientEmails || "tenant-admins",
          subject: input.subject,
          body: input.content,
          status: "sent",
          referenceType: "tenant_message",
          referenceId: id,
          sentAt: (/* @__PURE__ */ new Date()).toISOString().replace("T", " ").substring(0, 19),
          createdBy: ctx2.user?.id ?? "system",
          createdAt: (/* @__PURE__ */ new Date()).toISOString().replace("T", " ").substring(0, 19)
        });
      }
    }
    const targetOrg = input.targetOrgId ? await getOrganization(input.targetOrgId) : null;
    const recipientUsers = input.targetUserId ? [{ id: input.targetUserId }] : input.targetOrgId ? (await getUsersByOrganization(input.targetOrgId)).filter(
      (u) => u.role === "super_admin" || u.role === "admin"
    ) : [];
    const priorityMap = {
      "low": "low",
      "normal": "normal",
      "medium": "medium",
      "high": "high",
      "critical": "critical",
      "urgent": "high"
      // Map urgent to high
    };
    const mappedPriority = priorityMap[input.priority?.toLowerCase() || "normal"] || "normal";
    await Promise.all(
      recipientUsers.map(
        (u) => createNotification({
          userId: u.id,
          type: "system",
          title: input.subject,
          message: input.content,
          category: "tenant_message",
          entityType: "tenant_message",
          entityId: id,
          priority: mappedPriority,
          actionUrl: targetOrg?.slug ? `/org/${targetOrg.slug}/communications` : "/communications",
          isRead: 0,
          deliveryStatus: "sent",
          status: "active"
        })
      )
    );
    return { message: msg, success: true };
  }),
  getTenantMessages: enterpriseViewProcedure.input(external_exports.object({ limit: external_exports.number().optional(), offset: external_exports.number().optional() }).optional()).query(async ({ input }) => {
    const messages2 = await getTenantMessages(input);
    return { messages: messages2 };
  }),
  markTenantMessageRead: enterpriseEditProcedure.input(external_exports.object({ messageId: external_exports.string() })).mutation(async ({ input }) => {
    await markTenantMessageRead(input.messageId);
    return { success: true };
  }),
  // ── Org Self-Management (org users managing their own org) ────
  /** Get the current user's own organization details + enabled features */
  getMyOrg: protectedProcedure.query(async ({ ctx: ctx2 }) => {
    if (!ctx2.user.organizationId)
      throw new TRPCError2({ code: "NOT_FOUND", message: "No organization associated with this account" });
    const org = await getOrganization(ctx2.user.organizationId);
    if (!org) throw new TRPCError2({ code: "NOT_FOUND", message: "Organization not found" });
    const features = await getOrganizationFeatures(ctx2.user.organizationId);
    const featureMap = {};
    features.forEach((f) => {
      featureMap[f.featureKey] = Boolean(f.isEnabled);
    });
    const plan = (org.plan || "trial").toLowerCase();
    const tierDefaults = TIER_DEFAULT_FEATURES[plan];
    if (tierDefaults) {
      for (const [key, enabled] of Object.entries(tierDefaults)) {
        if (!(key in featureMap) || enabled && !featureMap[key]) {
          featureMap[key] = enabled;
        }
      }
    }
    ORG_MODULES.forEach((mod) => {
      if (!(mod.key in featureMap)) featureMap[mod.key] = true;
    });
    return { organization: org, featureMap };
  }),
  /** Update the current user's own organization (org super_admin only) */
  updateMyOrg: protectedProcedure.input(external_exports.object({
    name: external_exports.string().min(2).optional(),
    contactEmail: external_exports.string().email().optional(),
    contactPhone: external_exports.string().optional(),
    address: external_exports.string().optional(),
    country: external_exports.string().optional(),
    domain: external_exports.string().optional(),
    logoUrl: external_exports.string().optional(),
    industry: external_exports.string().optional(),
    website: external_exports.string().optional(),
    taxId: external_exports.string().optional(),
    billingEmail: external_exports.string().email().optional(),
    timezone: external_exports.string().optional(),
    currency: external_exports.string().optional(),
    description: external_exports.string().optional(),
    employeeCount: external_exports.number().optional(),
    registrationNumber: external_exports.string().optional(),
    paymentMethod: external_exports.string().optional(),
    // Email settings fields
    useGlobalSmtp: external_exports.boolean().optional(),
    smtpHost: external_exports.string().optional(),
    smtpPort: external_exports.string().optional(),
    smtpUser: external_exports.string().optional(),
    smtpPassword: external_exports.string().optional(),
    smtpFromEmail: external_exports.string().email().optional(),
    smtpFromName: external_exports.string().optional()
  })).mutation(async ({ input, ctx: ctx2 }) => {
    if (!ctx2.user.organizationId)
      throw new TRPCError2({ code: "FORBIDDEN", message: "No organization associated with this account" });
    if (ctx2.user.role !== "super_admin")
      throw new TRPCError2({ code: "FORBIDDEN", message: "Only organization administrators can update organization settings" });
    const { useGlobalSmtp, smtpHost, smtpPort, smtpUser, smtpPassword, smtpFromEmail, smtpFromName, ...orgData } = input;
    const updated = await updateOrganization(ctx2.user.organizationId, orgData);
    if (useGlobalSmtp === false && (smtpHost || smtpPort || smtpUser)) {
      try {
        const settingsDb = await getDb();
        if (settingsDb) {
          const settingsTable = (await Promise.resolve().then(() => (init_schema(), schema_exports))).settings;
          const orgIdStr = ctx2.user.organizationId;
          const emailSettings = {
            useGlobalSmtp: false,
            smtpHost: smtpHost || "",
            smtpPort: smtpPort || "587",
            smtpUser: smtpUser || "",
            smtpPassword: smtpPassword || "",
            // Should be encrypted in production
            smtpFromEmail: smtpFromEmail || "",
            smtpFromName: smtpFromName || ""
          };
          await settingsDb.insert(settingsTable).values({
            id: `${orgIdStr}_email_config`,
            organizationId: orgIdStr,
            category: "email",
            key: "config",
            value: JSON.stringify(emailSettings)
          }).onConflictDoUpdate({
            target: settingsTable.id,
            set: { value: JSON.stringify(emailSettings) }
          }).catch(() => {
            console.warn("[Settings] Could not save email config");
          });
        }
      } catch (err) {
        console.error("[Settings] Email config save error:", err);
      }
    }
    return { organization: updated, success: true };
  }),
  /** Test SMTP Connection */
  testSmtpConnection: protectedProcedure.input(external_exports.object({
    smtpHost: external_exports.string().min(1),
    smtpPort: external_exports.string().min(1),
    smtpUser: external_exports.string().min(1),
    smtpPassword: external_exports.string().min(1),
    smtpFromEmail: external_exports.string().email()
  })).mutation(async ({ input, ctx: ctx2 }) => {
    if (!ctx2.user.organizationId)
      throw new TRPCError2({ code: "FORBIDDEN", message: "No organization associated with this account" });
    if (ctx2.user.role !== "super_admin")
      throw new TRPCError2({ code: "FORBIDDEN", message: "Only organization administrators can test SMTP" });
    try {
      const nodemailer2 = require_nodemailer();
      const transporter = nodemailer2.createTransport({
        host: input.smtpHost,
        port: parseInt(input.smtpPort, 10),
        secure: parseInt(input.smtpPort, 10) === 465,
        auth: {
          user: input.smtpUser,
          pass: input.smtpPassword
        },
        connectionTimeout: 5e3,
        greetingTimeout: 5e3
      });
      await transporter.verify();
      return {
        success: true,
        message: "SMTP connection successful. Settings are valid."
      };
    } catch (error48) {
      console.error("[SMTP Test] Failed:", error48?.message);
      return {
        success: false,
        error: error48?.message || "SMTP connection failed. Please check your settings."
      };
    }
  }),
  /** List users in the current org (org super_admin only) */
  getMyOrgUsers: protectedProcedure.query(async ({ ctx: ctx2 }) => {
    if (!ctx2.user.organizationId)
      throw new TRPCError2({ code: "FORBIDDEN", message: "No organization" });
    if (ctx2.user.role !== "super_admin")
      throw new TRPCError2({ code: "FORBIDDEN", message: "Only organization administrators can view staff" });
    const orgUsers = await getUsersByOrganization(ctx2.user.organizationId);
    const safe = orgUsers.map(({ passwordHash, passwordResetToken, ...u }) => u);
    return { users: safe };
  }),
  /** Create a new user in the current org (org super_admin only) */
  inviteOrgUser: protectedProcedure.input(external_exports.object({
    name: external_exports.string().min(2),
    email: external_exports.string().email(),
    password: external_exports.string().min(8),
    role: external_exports.enum(["super_admin", "admin", "manager", "accountant", "hr", "staff", "sales_manager", "project_manager", "ict_manager", "procurement_manager"])
  })).mutation(async ({ input, ctx: ctx2 }) => {
    if (!ctx2.user.organizationId)
      throw new TRPCError2({ code: "FORBIDDEN" });
    if (ctx2.user.role !== "super_admin")
      throw new TRPCError2({ code: "FORBIDDEN", message: "Only organization administrators can create staff accounts" });
    const { getUserByEmail: getUserByEmail2, createUser: createUser2 } = await Promise.resolve().then(() => (init_db_users(), db_users_exports));
    const existing = await getUserByEmail2(input.email);
    if (existing) throw new TRPCError2({ code: "CONFLICT", message: "A user with this email already exists" });
    const bcrypt = await Promise.resolve().then(() => (init_bcryptjs(), bcryptjs_exports));
    const salt = await bcrypt.genSalt(10);
    const passwordHash = await bcrypt.hash(input.password, salt);
    const userId = `user_${Date.now()}_${Math.random().toString(36).substring(2, 11)}`;
    const newUser = await createUser2({
      id: userId,
