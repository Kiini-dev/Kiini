          sensitivity: 0.4,
          range: { min: -15, max: 20 },
          scenarios: buildScenarios(0.04, [-15, 0, 10, 20])
        }
      ];
      const allValues = analyses.flatMap((a) => a.scenarios.map((s) => s.forecastValue));
      return {
        baseValue: Math.round(base),
        metric: input.metric,
