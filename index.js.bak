// server/routers/reportExport.ts
var reportCreateProcedure = createFeatureRestrictedProcedure2("reports:create");
var reportExportProcedure = createFeatureRestrictedProcedure2("reports:export");
var reportExportRouter = router({
  // Generate financial report in multiple formats
  generateFinancialReport: reportCreateProcedure.input(
    external_exports.object({
      title: external_exports.string().default("Financial Report"),
      format: external_exports.enum(["pdf", "csv", "txt", "json"]).default("pdf"),
      startDate: external_exports.date().optional(),
      endDate: external_exports.date().optional(),
      includeDetails: external_exports.boolean().default(true)
    })
  ).mutation(async ({ input }) => {
    try {
      const config2 = {
        title: input.title,
        startDate: input.startDate,
        endDate: input.endDate,
        includeDetails: input.includeDetails
      };
      let buffer;
      let mimeType;
      let filename;
      const dateStr = (/* @__PURE__ */ new Date()).toISOString().split("T")[0];
      switch (input.format) {
        case "csv":
          buffer = await generateFinancialReportCSV(config2);
          mimeType = "text/csv";
          filename = `Financial_Report_${dateStr}.csv`;
          break;
        case "txt":
          buffer = await generateFinancialReportTXT(config2);
          mimeType = "text/plain";
          filename = `Financial_Report_${dateStr}.txt`;
          break;
        case "json":
          buffer = await generateFinancialReportJSON(config2);
          mimeType = "application/json";
          filename = `Financial_Report_${dateStr}.json`;
          break;
        case "pdf":
        default:
          buffer = await generateFinancialReportPDF(config2);
          mimeType = "application/pdf";
          filename = `Financial_Report_${dateStr}.pdf`;
          break;
      }
      const base643 = buffer.toString("base64");
      return {
        success: true,
        data: base643,
        filename,
        mimeType
      };
    } catch (error48) {
      console.error("Error generating financial report:", error48);
      return {
        success: false,
        error: error48 instanceof Error ? error48.message : "Failed to generate report"
      };
    }
  }),
  // Generate expense report PDF
  generateExpenseReport: reportExportProcedure.input(
    external_exports.object({
      title: external_exports.string().default("Expense Report"),
      startDate: external_exports.date().optional(),
      endDate: external_exports.date().optional(),
      includeDetails: external_exports.boolean().default(true)
    })
  ).mutation(async ({ input }) => {
    try {
      const pdfBuffer = await generateExpenseReportPDF({
        title: input.title,
        startDate: input.startDate,
        endDate: input.endDate,
        includeDetails: input.includeDetails
      });
      const base643 = pdfBuffer.toString("base64");
      return {
        success: true,
        data: base643,
        filename: `Expense_Report_${(/* @__PURE__ */ new Date()).toISOString().split("T")[0]}.pdf`
      };
    } catch (error48) {
      console.error("Error generating expense report:", error48);
      return {
        success: false,
        error: error48 instanceof Error ? error48.message : "Failed to generate report"
      };
    }
  })
});

