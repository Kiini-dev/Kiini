    } catch {
      return [];
    }
  }),
  // ─── List available tables ────────────────────────────────────────
  listTables: adminViewProcedure.query(async () => {
    return ALL_TABLES.map((t2) => ({ key: t2.key, label: t2.label }));
  }),
  // ─── Create Backup ────────────────────────────────────────────────
  createBackup: adminEditProcedure.input(external_exports.object({
    name: external_exports.string().min(1).max(200),
    scope: external_exports.enum(["full", "organization", "tables"]).default("full"),
    organizationId: external_exports.string().optional(),
    selectedTables: external_exports.array(external_exports.string()).optional()
  })).mutation(async ({ input, ctx: ctx2 }) => {
    const database2 = await getDb();
    const id = v4_default();
    const timestamp3 = (/* @__PURE__ */ new Date()).toISOString();
    const createdBy = ctx2.user?.id || "system";
    const scopeEntityId = input.organizationId || null;
    await database2.execute(sql29`INSERT INTO backup_history (id, name, backupType, scope, scopeEntityId, status, createdBy) VALUES (${id}, ${input.name}, 'manual', ${input.scope}, ${scopeEntityId}, 'running', ${createdBy})`);
    try {
      const backupData = {
        metadata: {
          version: "2.0",
          id,
          name: input.name,
          scope: input.scope,
          organizationId: input.organizationId || null,
          timestamp: timestamp3,
          createdBy: ctx2.user?.id || "system",
          createdByEmail: ctx2.user?.email || ""
        },
        data: {}
      };
      let tablesToBackup = ALL_TABLES;
      if (input.scope === "tables" && input.selectedTables?.length) {
        tablesToBackup = ALL_TABLES.filter((t2) => input.selectedTables.includes(t2.key));
      }
      let totalRecords = 0;
      const backedUpTables = [];
      for (const table of tablesToBackup) {
        try {
          let records;
          if (input.scope === "organization" && input.organizationId) {
            try {
              records = await database2.select().from(table.schema).where(eq136(table.schema.organizationId, input.organizationId));
            } catch {
              records = await database2.select().from(table.schema);
            }
          } else {
            records = await database2.select().from(table.schema);
          }
          if (records.length > 0) {
            backupData.data[table.key] = records;
            totalRecords += records.length;
            backedUpTables.push(table.key);
          }
        } catch (err) {
          console.warn(`Backup: skipping table ${table.key}: ${err.message}`);
        }
      }
      const jsonStr = JSON.stringify(backupData);
      const sizeBytes = Buffer.byteLength(jsonStr, "utf8");
      const fileName = `backup_${input.scope}_${(/* @__PURE__ */ new Date()).toISOString().replace(/[:.]/g, "-")}.json`;
      await database2.execute(sql29`UPDATE backup_history SET status = 'completed', tablesList = ${backedUpTables.join(",")}, recordCount = ${totalRecords}, sizeBytes = ${sizeBytes}, fileName = ${fileName}, completedAt = NOW() WHERE id = ${id}`);
      try {
        await logActivity({
          userId: ctx2.user?.id || "system",
          action: "backup_created",
          entityType: "backup",
          entityId: id,
          description: `Backup "${input.name}" created: ${totalRecords} records from ${backedUpTables.length} tables (${input.scope})`
        });
      } catch {
      }
      return {
        success: true,
        backupId: id,
        backup: backupData,
        fileName,
        stats: { totalRecords, tablesBackedUp: backedUpTables.length, sizeBytes }
      };
    } catch (err) {
      console.error("Backup error:", err);
      try {
        await database2.execute(sql29`UPDATE backup_history SET status = 'failed', errorMessage = ${err.message} WHERE id = ${id}`);
      } catch (updateErr) {
        console.error("Failed to update backup status:", updateErr);
      }
      throw new TRPCError2({ code: "INTERNAL_SERVER_ERROR", message: `Backup failed: ${err.message}` });
    }
  }),
  // ─── Restore Backup ───────────────────────────────────────────────
  restoreBackup: adminEditProcedure.input(external_exports.object({
    backupData: external_exports.string(),
    mode: external_exports.enum(["merge", "replace"]).default("merge"),
    selectedTables: external_exports.array(external_exports.string()).optional()
  })).mutation(async ({ input, ctx: ctx2 }) => {
    const database2 = await getDb();
    let backup;
    try {
      backup = JSON.parse(input.backupData);
    } catch {
      throw new TRPCError2({ code: "BAD_REQUEST", message: "Invalid backup file: not valid JSON" });
    }
    if (!backup.metadata || !backup.data) {
      throw new TRPCError2({ code: "BAD_REQUEST", message: "Invalid backup file: missing metadata or data" });
    }
    const results = { restored: 0, skipped: 0, errors: [], tablesProcessed: 0 };
    const dataKeys = Object.keys(backup.data);
    const tablesToRestore = input.selectedTables?.length ? dataKeys.filter((k) => input.selectedTables.includes(k)) : dataKeys;
    for (const key of tablesToRestore) {
      const tableDef = ALL_TABLES.find((t2) => t2.key === key);
      if (!tableDef) continue;
      const records = backup.data[key];
      if (!Array.isArray(records) || records.length === 0) continue;
      const schemaColumns = getTableColumns(tableDef.schema);
      const validColNames = new Set(Object.keys(schemaColumns));
      try {
        if (input.mode === "replace") {
          await database2.execute(sql29.raw(`DELETE FROM \`${key}\``));
        }
        for (const record2 of records) {
          try {
            const cleanRecord = { ...record2 };
            if (key === "users") delete cleanRecord.password;
            const cols = Object.keys(cleanRecord).filter((c) => validColNames.has(c));
            if (cols.length === 0) continue;
            const colStr = cols.map((c) => `\`${c}\``).join(", ");
            const valueParts = cols.map((c) => sql29`${cleanRecord[c]}`);
            const valuesSql = sql29.join(valueParts, sql29.raw(", "));
            const insertKeyword = input.mode === "merge" ? "INSERT IGNORE" : "INSERT";
            const insertSql = sql29.join([
              sql29.raw(`${insertKeyword} INTO \`${key}\` (${colStr}) VALUES (`),
              valuesSql,
              sql29.raw(")")
            ]);
            const insertResult = await database2.execute(insertSql);
            const affected = insertResult?.[0]?.affectedRows ?? insertResult?.affectedRows ?? 1;
            if (affected > 0) {
              results.restored++;
            } else {
              results.skipped++;
            }
          } catch (err) {
            if (err?.message?.includes("Duplicate entry") || err?.code === "ER_DUP_ENTRY") {
              results.skipped++;
            } else {
              results.errors.push(`${key}: ${err.message}`);
            }
          }
        }
        results.tablesProcessed++;
      } catch (err) {
        results.errors.push(`Table ${key}: ${err.message}`);
      }
    }
    const id = v4_default();
    try {
      const name = `Restore: ${backup.metadata.name || "uploaded backup"}`;
      const scope = backup.metadata.scope || "full";
      const status = results.errors.length === 0 ? "completed" : "completed_with_errors";
      const tablesStr = tablesToRestore.join(",");
      const createdBy = ctx2.user?.id || "system";
      await database2.execute(sql29`INSERT INTO backup_history (id, name, backupType, scope, status, recordCount, tablesList, createdBy, completedAt) VALUES (${id}, ${name}, 'restore', ${scope}, ${status}, ${results.restored}, ${tablesStr}, ${createdBy}, NOW())`);
    } catch {
    }
    try {
      await logActivity({
        userId: ctx2.user?.id || "system",
        action: "backup_restored",
        entityType: "backup",
        entityId: id,
        description: `Backup restored (${input.mode}): ${results.restored} records, ${results.skipped} skipped, ${results.errors.length} errors`
      });
    } catch {
    }
    return {
      success: results.errors.length === 0,
      results,
      message: `Restored ${results.restored} records from ${results.tablesProcessed} tables`
    };
  }),
  // ─── Backup History ───────────────────────────────────────────────
  listHistory: adminViewProcedure.input(external_exports.object({ limit: external_exports.number().default(50), status: external_exports.string().optional() })).query(async ({ input }) => {
    const database2 = await getDb();
    try {
      let rows;
      if (input.status) {
        rows = await database2.select().from(backupHistory).where(eq136(backupHistory.status, input.status)).orderBy(desc79(backupHistory.createdAt)).limit(input.limit);
