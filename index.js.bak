  `;
  return { html, text: text3 };
}
async function sendOverdueReminders() {
  const db = await getDb();
  if (!db) {
    console.error("[OVERDUE REMINDERS] Database not available");
    return { sent: 0, skipped: 0, errors: 0 };
  }
  let appName = "CRM";
  let cur = "KES";
  const baseUrl = process.env.APP_URL || "";
