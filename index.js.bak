    await db.update(notifications).set({
      isRead: 1,
      readAt: (/* @__PURE__ */ new Date()).toISOString().replace("T", " ").substring(0, 19)
    }).where(
      and50(
        eq59(notifications.id, input.id),
        eq59(notifications.userId, ctx2.user.id)
      )
    );
    broadcastNotificationRead(ctx2.user.id, input.id);
    return { success: true };
  }),
  /**
   * Mark notification as unread
   */
  markAsUnread: createFeatureRestrictedProcedure2("notifications:edit").input(external_exports.object({ id: external_exports.string() })).mutation(async ({ input, ctx: ctx2 }) => {
    const db = await getDb();
    if (!db) throw new Error("Database not available");
    await db.update(notifications).set({
      isRead: 0,
      readAt: null
    }).where(
      and50(
        eq59(notifications.id, input.id),
        eq59(notifications.userId, ctx2.user.id)
      )
    );
    broadcastUnreadCountChanged(ctx2.user.id, 1);
    return { success: true };
  }),
  /**
   * Mark all notifications as read
   */
  markAllAsRead: createFeatureRestrictedProcedure2("notifications:edit").mutation(async ({ ctx: ctx2 }) => {
    const db = await getDb();
    if (!db) throw new Error("Database not available");
    await db.update(notifications).set({
      isRead: 1,
      readAt: (/* @__PURE__ */ new Date()).toISOString().replace("T", " ").substring(0, 19)
    }).where(
      and50(
        eq59(notifications.userId, ctx2.user.id),
        eq59(notifications.isRead, 0)
      )
    );
    broadcastUnreadCountChanged(ctx2.user.id, 0);
    return { success: true };
  }),
  /**
   * Create notification (internal use by other routers)
   */
  create: createFeatureRestrictedProcedure2("notifications:create").input(
    external_exports.object({
      userId: external_exports.string(),
      title: external_exports.string(),
      message: external_exports.string(),
      type: external_exports.enum(["info", "success", "warning", "error", "reminder"]).default("info"),
      category: external_exports.string().optional(),
      entityType: external_exports.string().optional(),
      entityId: external_exports.string().optional(),
      actionUrl: external_exports.string().optional(),
      priority: external_exports.enum(["low", "normal", "high"]).default("normal"),
      expiresAt: external_exports.date().optional()
    })
  ).mutation(async ({ input }) => {
    const db = await getDb();
    if (!db) throw new Error("Database not available");
    const id = v4_default();
    const notificationData = {
      id,
      userId: input.userId,
      title: input.title,
      message: input.message,
      type: input.type,
      category: input.category,
      entityType: input.entityType,
      entityId: input.entityId,
      actionUrl: input.actionUrl,
      priority: input.priority,
      expiresAt: input.expiresAt?.toISOString().replace("T", " ").substring(0, 19),
      isRead: 0,
      createdAt: (/* @__PURE__ */ new Date()).toISOString().replace("T", " ").substring(0, 19),
      readAt: null
    };
    await db.insert(notifications).values(notificationData);
    broadcastNotification(input.userId, notificationData);
    broadcastUnreadCountChanged(input.userId, 1);
    return { id };
  }),
  /**
   * Delete notification
   */
  delete: createFeatureRestrictedProcedure2("notifications:delete").input(external_exports.string()).mutation(async ({ input, ctx: ctx2 }) => {
    const db = await getDb();
    if (!db) throw new Error("Database not available");
    await db.delete(notifications).where(
      and50(
        eq59(notifications.id, input),
        eq59(notifications.userId, ctx2.user.id)
      )
    );
    broadcastNotificationDeleted(ctx2.user.id, input);
    return { success: true };
  }),
  /**
   * Delete all read notifications
   */
  deleteRead: createFeatureRestrictedProcedure2("notifications:delete").mutation(async ({ ctx: ctx2 }) => {
    const db = await getDb();
    if (!db) throw new Error("Database not available");
    await db.delete(notifications).where(
      and50(
        eq59(notifications.userId, ctx2.user.id),
        eq59(notifications.isRead, 1)
      )
    );
    return { success: true };
  }),
  /**
   * Get notifications by category
   */
  byCategory: createFeatureRestrictedProcedure2("notifications:read").input(
    external_exports.object({
      category: external_exports.string(),
      unreadOnly: external_exports.boolean().default(false)
    })
  ).query(async ({ input, ctx: ctx2 }) => {
    const db = await getDb();
    if (!db) return [];
    let query = db.select().from(notifications).where(
      and50(
        eq59(notifications.userId, ctx2.user.id),
        eq59(notifications.category, input.category)
      )
    );
    if (input.unreadOnly) {
      query = query.where(eq59(notifications.isRead, 0));
    }
    return await query.orderBy(desc18(notifications.createdAt));
  }),
  /**
   * Subscribe to real-time notification updates
   */
  onNotification: notificationsSubscription
});

