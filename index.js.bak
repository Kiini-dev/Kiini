// server/routers/clientScoring.ts
var readProcedure4 = createFeatureRestrictedProcedure2("analytics:view");
async function calculateClientHealthScore(clientId) {
  const db = await getDb();
  if (!db) return null;
  try {
    const client = await db.getClient(clientId);
    if (!client) return null;
    const invoices6 = await db.getInvoicesByClient(clientId);
    let paidOnTimeCount = 0;
    let totalInvoices = 0;
    for (const invoice of invoices6) {
      const daysLate = differenceInDays(new Date(invoice.paidAt || /* @__PURE__ */ new Date()), new Date(invoice.dueDate));
      if (daysLate <= 0) {
        paidOnTimeCount++;
      }
      totalInvoices++;
    }
    const paymentTimelinessScore = totalInvoices > 0 ? Math.round(paidOnTimeCount / totalInvoices * 25) : 12;
    const invoiceFrequency = totalInvoices;
    let invoiceFrequencyScore = 0;
    if (invoiceFrequency >= 12) invoiceFrequencyScore = 20;
    else if (invoiceFrequency >= 8) invoiceFrequencyScore = 15;
    else if (invoiceFrequency >= 4) invoiceFrequencyScore = 10;
    else if (invoiceFrequency >= 1) invoiceFrequencyScore = 5;
    const totalRevenue = invoices6.reduce((sum5, inv) => sum5 + inv.total, 0);
    let revenueScore = 0;
    if (totalRevenue >= 5e6) revenueScore = 20;
    else if (totalRevenue >= 1e6) revenueScore = 15;
    else if (totalRevenue >= 5e5) revenueScore = 10;
    else if (totalRevenue > 0) revenueScore = 5;
    const overdueAmount = invoices6.filter((inv) => new Date(inv.dueDate) < /* @__PURE__ */ new Date()).reduce((sum5, inv) => sum5 + (inv.total - inv.paidAmount), 0);
    let overdueScore = 20;
    if (overdueAmount > 1e6) overdueScore = 0;
    else if (overdueAmount > 5e5) overdueScore = 5;
    else if (overdueAmount > 1e5) overdueScore = 10;
    else if (overdueAmount > 0) overdueScore = 15;
    const projects3 = await db.getClientProjects(clientId);
    const completedProjects = projects3.filter((p) => p.status === "completed").length;
    const projectSuccessRate = projects3.length > 0 ? Math.round(completedProjects / projects3.length * 15) : 7;
    const totalScore = paymentTimelinessScore + invoiceFrequencyScore + revenueScore + overdueScore + projectSuccessRate;
    let churnRisk = 0;
    if (totalScore < 40) churnRisk = 80;
    else if (totalScore < 60) churnRisk = 50;
    else if (totalScore < 80) churnRisk = 20;
    else churnRisk = 5;
    let riskLevel = "green";
    if (totalScore >= 80) riskLevel = "green";
    else if (totalScore >= 60) riskLevel = "yellow";
    else riskLevel = "red";
    const lifetimeValue = totalRevenue;
    const scoreId = v4_default();
    await db.insertClientHealthScore({
      id: scoreId,
      clientId,
      healthScore: Math.min(100, totalScore),
      riskLevel,
      paymentTimeliness: paymentTimelinessScore,
      invoiceFrequency: invoiceFrequencyScore,
      totalRevenue,
      overdueAmount,
      projectSuccessRate,
      churnRisk,
      lifetimeValue
    });
    return {
      id: scoreId,
      clientId,
      healthScore: Math.min(100, totalScore),
      riskLevel,
      paymentTimeliness: paymentTimelinessScore,
      invoiceFrequency: invoiceFrequencyScore,
      totalRevenue,
      overdueAmount,
      projectSuccessRate,
      churnRisk,
      lifetimeValue
    };
  } catch (error48) {
    console.error("[CLIENT SCORING] Error calculating health score:", error48);
    return null;
  }
}
var clientScoringRouter = router({
  /**
   * Get health score for a specific client
   */
  getClientScore: readProcedure4.input(external_exports.object({ clientId: external_exports.string() })).query(async ({ input }) => {
    const db = await getDb();
    if (!db) return null;
    try {
      let score = await db.getClientHealthScore(input.clientId);
      if (!score || differenceInDays(/* @__PURE__ */ new Date(), new Date(score.calculatedAt)) > 7) {
        score = await calculateClientHealthScore(input.clientId);
      }
      return score;
    } catch (error48) {
      console.error("[CLIENT SCORING] Error getting client score:", error48);
      return null;
    }
  }),
  /**
   * Get all client scores (risk dashboard)
   */
  getAllClientScores: readProcedure4.input(
    external_exports.object({
      riskLevel: external_exports.enum(["green", "yellow", "red"]).optional(),
      sortBy: external_exports.enum(["healthScore", "totalRevenue", "churnRisk"]).default("healthScore"),
      limit: external_exports.number().default(100)
    })
  ).query(async ({ input }) => {
    const db = await getDb();
    if (!db) return { scores: [] };
    try {
