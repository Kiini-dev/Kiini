  clientDistribution: createFeatureRestrictedProcedure2("analytics:view").query(async () => {
    const db = await getDb();
    if (!db) return [];
    try {
      const distribution = await db.select({
        status: clients.status,
        count: count4().as("count")
      }).from(clients).groupBy(clients.status);
      return distribution;
    } catch (error48) {
      console.error("Client distribution error:", error48);
      return [];
    }
  }),
  /**
   * Get invoice status metrics
