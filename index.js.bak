  /**
   * Get calendar events for a given month (global – no org scope).
   * Aggregates invoice due dates, project end dates, and task due dates.
   */
  getCalendarEvents: protectedProcedure.input(external_exports.object({
    year: external_exports.number().int().min(2e3).max(2100),
    month: external_exports.number().int().min(1).max(12)
  })).query(async ({ input, ctx: ctx2 }) => {
    const db = await getDb();
    if (!db) return { events: [] };
    try {
      const orgId = ctx2.user.organizationId || null;
      const padded = (n) => String(n).padStart(2, "0");
      const startOfMonth = `${input.year}-${padded(input.month)}-01 00:00:00`;
      const lastDay = new Date(input.year, input.month, 0).getDate();
      const endOfMonth = `${input.year}-${padded(input.month)}-${padded(lastDay)} 23:59:59`;
      const [monthInvoices, monthProjects] = await Promise.all([
        db.select().from(invoices).where(
          withOrg(
            invoices,
            orgId,
            gte8(invoices.dueDate, startOfMonth),
            lte8(invoices.dueDate, endOfMonth)
          )
        ).limit(500),
        db.select().from(projects).where(orgFilter(projects, orgId)).limit(2e3)
      ]);
      const projectsDueThisMonth = monthProjects.filter((p) => {
        if (!p.endDate) return false;
        const d = String(p.endDate).slice(0, 10);
        return d >= startOfMonth.slice(0, 10) && d <= endOfMonth.slice(0, 10);
      });
      const allProjectIds = monthProjects.map((p) => p.id);
      let tasksDue = [];
      if (allProjectIds.length > 0) {
        tasksDue = await db.select().from(projectTasks).where(
          and42(
            inArray11(projectTasks.projectId, allProjectIds),
            gte8(projectTasks.dueDate, startOfMonth),
            lte8(projectTasks.dueDate, endOfMonth)
          )
        ).limit(500);
      }
      const events = [];
      for (const inv of monthInvoices) {
        events.push({
          id: `inv_${inv.id}`,
          type: "invoice",
          title: `Invoice ${inv.invoiceNumber} due`,
          date: String(inv.dueDate).slice(0, 10),
          status: inv.status,
          href: `/invoices/${inv.id}`,
          color: inv.status === "paid" ? "#22c55e" : inv.status === "overdue" ? "#ef4444" : "#3b82f6"
        });
      }
      for (const proj of projectsDueThisMonth) {
        events.push({
          id: `proj_${proj.id}`,
          type: "project",
          title: `${proj.name} deadline`,
          date: String(proj.endDate).slice(0, 10),
          status: proj.status,
          href: `/projects/${proj.id}`,
          color: proj.status === "completed" ? "#22c55e" : proj.status === "on_hold" ? "#f59e0b" : "#a855f7"
        });
      }
      for (const task of tasksDue) {
        if (!task.dueDate) continue;
        events.push({
          id: `task_${task.id}`,
          type: "task",
          title: task.title,
          date: String(task.dueDate).slice(0, 10),
          status: task.status,
          href: `/projects/${task.projectId}`,
          color: task.status === "completed" ? "#22c55e" : task.priority === "urgent" ? "#ef4444" : "#f97316"
        });
      }
      return { events };
    } catch (error48) {
      console.error("[dashboard.getCalendarEvents] Error:", error48);
      return { events: [] };
    }
  }),
