  getById: publicProcedure.input(external_exports.object({ productId: external_exports.string() })).query(async ({ input }) => {
    try {
      const database2 = await getDb();
      if (!database2) {
        throw new TRPCError2({ code: "INTERNAL_SERVER_ERROR", message: "Database connection failed" });
      }
      const product = await database2.select().from(products).where(eq83(products.id, input.productId)).limit(1).then((result) => result[0] || null).catch(() => null);
      if (!product) {
        throw new TRPCError2({
          code: "NOT_FOUND",
          message: "Product not found"
        });
      }
      return {
        id: product.id,
        sku: product.sku,
        productName: product.name,
        category: product.category,
        quantity: product.stockQuantity || 0,
        reorderLevel: product.reorderPoint || 0,
        unitCost: product.unitPrice || 0
      };
    } catch (error48) {
      console.error("Error fetching inventory:", error48);
      throw new TRPCError2({
        code: "INTERNAL_SERVER_ERROR",
        message: "Failed to fetch inventory"
      });
    }
  }),
  /**
   * Create or update inventory record
