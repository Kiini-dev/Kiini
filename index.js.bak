        const totalExpenses = allExpenses.reduce((s, e) => s + (e.amount || 0), 0);
        const avgRevenue = totalRevenue / monthCount;
        const avgExpenses = totalExpenses / Math.max(1, monthCount);
        if (input.metric === "revenue") baseValue = avgRevenue;
