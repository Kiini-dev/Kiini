        shifContribution: p.shifContribution,
        housingLevyDeduction: p.housingLevyDeduction,
        netSalary: p.netSalary
      }));
      const totals = calculateYTDTotals(calculations);
      return totals;
    } catch (error48) {
      console.error("Year to Date Summary error:", error48);
      return {};
    }
  })
});

