  deleteTask: hrWriteProcedure.input(external_exports.object({ taskId: external_exports.string() })).mutation(async ({ input }) => {
    const p = pool3();
    await p.query(`DELETE FROM onboardingTasks WHERE id = ?`, [input.taskId]);
