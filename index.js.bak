// server/routers/enhancedPayments.ts
init_trpc();
init_zod();
init_dist();
init_db();
init_schema();
init_dist_node();
init_db();
import { eq as eq81, and as and68 } from "drizzle-orm";
var readProcedure21 = createFeatureRestrictedProcedure2("accounting:payments:view");
var writeProcedure9 = createFeatureRestrictedProcedure2("accounting:payments:create");
var enhancedPaymentsRouter = router({
  /**
   * Create payment with automatic COA balance update
   */
  createPaymentWithCOA: writeProcedure9.input(external_exports.object({
    invoiceId: external_exports.string(),
    clientId: external_exports.string(),
    accountId: external_exports.string().describe("Chart of Accounts ID for payment destination"),
    amount: external_exports.number().positive(),
    paymentDate: external_exports.string(),
    paymentMethod: external_exports.enum(["cash", "bank_transfer", "cheque", "mpesa", "card", "other"]),
    referenceNumber: external_exports.string().optional(),
    chartOfAccountType: external_exports.enum(["debit", "credit"]).default("debit"),
    notes: external_exports.string().optional()
  })).mutation(async ({ input, ctx: ctx2 }) => {
    const database2 = await getDb();
    if (!database2) {
      throw new TRPCError2({
        code: "INTERNAL_SERVER_ERROR",
        message: "Database not available"
      });
    }
    try {
      const invoiceData = await database2.select().from(invoices).where(eq81(invoices.id, input.invoiceId)).limit(1);
      if (!invoiceData || invoiceData.length === 0) {
        throw new TRPCError2({
          code: "NOT_FOUND",
          message: "Invoice not found"
        });
      }
      const invoice = invoiceData[0];
      const accountData = await database2.select().from(accounts).where(eq81(accounts.id, input.accountId)).limit(1);
      if (!accountData || accountData.length === 0) {
        throw new TRPCError2({
          code: "NOT_FOUND",
          message: "Chart of Accounts entry not found"
        });
      }
      const account = accountData[0];
      const existingPayments = await database2.select().from(payments).where(
        and68(
          eq81(payments.invoiceId, input.invoiceId),
          eq81(payments.status, "completed")
        )
      );
      const totalPaid = existingPayments.reduce((sum5, p) => sum5 + (p.amount || 0), 0);
      if (totalPaid + input.amount > invoice.total) {
        throw new TRPCError2({
          code: "BAD_REQUEST",
          message: `Payment amount exceeds invoice total. Invoice: ${invoice.total}, Already paid: ${totalPaid}, Attempting to pay: ${input.amount}`
        });
      }
      const paymentId = v4_default();
      await database2.insert(payments).values({
        id: paymentId,
        invoiceId: input.invoiceId,
        clientId: input.clientId,
        accountId: input.accountId,
        amount: input.amount,
        // Store as whole currency units
        paymentDate: new Date(input.paymentDate).toISOString(),
        paymentMethod: input.paymentMethod,
        referenceNumber: input.referenceNumber || null,
        chartOfAccountType: input.chartOfAccountType,
        notes: input.notes || null,
        status: "completed",
        createdBy: ctx2.user.id,
        createdAt: (/* @__PURE__ */ new Date()).toISOString().replace("T", " ").substring(0, 19)
      });
      const balanceChange = input.chartOfAccountType === "debit" ? input.amount : -input.amount;
      const newBalance = (account.balance || 0) + balanceChange;
      await database2.update(accounts).set({
        balance: newBalance,
        updatedAt: (/* @__PURE__ */ new Date()).toISOString().replace("T", " ").substring(0, 19)
      }).where(eq81(accounts.id, input.accountId));
      const newPaidAmount = invoice.paidAmount + input.amount;
      const newInvoiceStatus = newPaidAmount >= invoice.total ? "paid" : "partial";
      await database2.update(invoices).set({
        paidAmount: newPaidAmount,
        status: newInvoiceStatus,
        updatedAt: (/* @__PURE__ */ new Date()).toISOString().replace("T", " ").substring(0, 19)
      }).where(eq81(invoices.id, input.invoiceId));
      await logActivity({
        userId: ctx2.user.id,
        action: "payment_created_with_coa_update",
        entityType: "payment",
        entityId: paymentId,
        description: `Payment of ${input.amount} created for invoice ${invoice.invoiceNumber} with COA ${account.accountCode} update`
      });
      return {
        success: true,
        paymentId,
        newBalance,
        invoiceStatus: newInvoiceStatus,
        message: "Payment processed successfully with COA balance updated"
      };
    } catch (error48) {
      if (error48 instanceof TRPCError2) throw error48;
      throw new TRPCError2({
        code: "INTERNAL_SERVER_ERROR",
        message: `Failed to create payment: ${error48}`
      });
    }
  }),
  /**
   * Get payment with COA details
   */
  getPaymentWithCOA: readProcedure21.input(external_exports.string()).query(async ({ input }) => {
    const database2 = await getDb();
    if (!database2) {
      throw new TRPCError2({
        code: "INTERNAL_SERVER_ERROR",
        message: "Database not available"
      });
    }
    const paymentData = await database2.select().from(payments).where(eq81(payments.id, input)).limit(1);
    if (!paymentData || paymentData.length === 0) {
      throw new TRPCError2({
        code: "NOT_FOUND",
        message: "Payment not found"
      });
    }
    const payment = paymentData[0];
    const invoiceData = await database2.select().from(invoices).where(eq81(invoices.id, payment.invoiceId));
    const accountData = payment.accountId ? await database2.select().from(accounts).where(eq81(accounts.id, payment.accountId)) : [];
    return {
      payment,
      invoice: invoiceData[0] || null,
      account: accountData[0] || null
    };
  }),
  /**
   * List payments for an invoice with COA details
   */
  listInvoicePayments: readProcedure21.input(external_exports.string()).query(async ({ input }) => {
    const database2 = await getDb();
    if (!database2) {
      throw new TRPCError2({
        code: "INTERNAL_SERVER_ERROR",
        message: "Database not available"
      });
    }
    const paymentList = await database2.select().from(payments).where(eq81(payments.invoiceId, input));
    const enriched = await Promise.all(
      paymentList.map(async (payment) => {
        if (!payment.accountId) return payment;
