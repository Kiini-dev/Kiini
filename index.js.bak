      const query = orgId ? database2.select().from(payments).where(eq20(payments.organizationId, orgId)) : database2.select().from(payments);
      return await query.limit(input?.limit || 50).offset(input?.offset || 0);
    } catch (error48) {
      console.error("Error fetching payments list:", error48);
      return [];
    }
