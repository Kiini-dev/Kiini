        month: invoices.issueDate,
        total: sum2(invoices.total).as("total"),
        count: count4().as("count")
      }).from(invoices).where(eq58(invoices.status, "paid")).groupBy(invoices.issueDate).limit(input.months);
      return trends;
    } catch (error48) {
      console.error("Revenue trends error:", error48);
      return [];
    }
  }),
  /**
