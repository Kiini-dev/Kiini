        const invoice = invoiceData[0];
        const newPaidAmount = Math.max(0, (invoice.paidAmount || 0) - (payment.amount || 0));
        const newInvoiceStatus = newPaidAmount === 0 ? "draft" : "partial";
        await database2.update(invoices).set({
          paidAmount: newPaidAmount,
          status: newInvoiceStatus,
          updatedAt: (/* @__PURE__ */ new Date()).toISOString().replace("T", " ").substring(0, 19)
        }).where(eq81(invoices.id, payment.invoiceId));
      }
      await database2.update(payments).set({
        status: "cancelled",
        updatedAt: (/* @__PURE__ */ new Date()).toISOString().replace("T", " ").substring(0, 19)
      }).where(eq81(payments.id, input.paymentId));
      await logActivity({
        userId: ctx2.user.id,
        action: "payment_reversed",
        entityType: "payment",
        entityId: input.paymentId,
        description: `Payment reversed: ${input.reason || "No reason provided"}`
      });
      return {
        success: true,
        message: "Payment reversed successfully with COA balance updated",
        newBalance
      };
    } catch (error48) {
      if (error48 instanceof TRPCError2) throw error48;
      throw new TRPCError2({
        code: "INTERNAL_SERVER_ERROR",
        message: `Failed to reverse payment: ${error48}`
      });
    }
  }),
  /**
   * Get COA account balance for payment verification
   */
  getAccountBalance: readProcedure21.input(external_exports.string()).query(async ({ input }) => {
    const database2 = await getDb();
    if (!database2) {
      throw new TRPCError2({
