    ledgerBudgets = mysqlTable2(
      "ledgerBudgets",
      {
        id: varchar2("id", { length: 64 }).primaryKey(),
        accountId: varchar2("accountId", { length: 64 }).notNull(),
        // Reference to chart of accounts
        year: int2("year").notNull(),
        month: int2("month"),
        // 1-12; null for annual budgets
        budgetedAmount: int2("budgetedAmount").notNull(),
        // in cents
        actual: int2("actual").default(0).notNull(),
        // in cents
        variance: int2("variance").notNull(),
        // budgetedAmount - actual
        variancePercentage: int2("variancePercentage"),
        // Percentage variance
        notes: text2("notes"),
        createdBy: varchar2("createdBy", { length: 64 }),
        createdAt: timestamp2("createdAt").defaultNow(),
        updatedAt: timestamp2("updatedAt").defaultNow()
      },
      (table) => ({
        accountIdx: index2("ledger_budget_account_idx").on(table.accountId),
        yearIdx: index2("ledger_budget_year_idx").on(table.year),
        monthIdx: index2("ledger_budget_month_idx").on(table.month)
      })
    );
    budgetAllocations = mysqlTable2(
      "budgetAllocations",
      {
        id: varchar2("id", { length: 64 }).primaryKey(),
        budgetId: varchar2("budgetId", { length: 64 }).notNull(),
        // Can reference project, department, or ledger budgets
        categoryName: varchar2("categoryName", { length: 255 }).notNull(),
        allocatedAmount: int2("allocatedAmount").notNull(),
