import { eq as eq59, and as and50, desc as desc18 } from "drizzle-orm";
var notificationsRouter = router({
  /**
   * Get user's unread notifications
   */
  unread: protectedProcedure.query(async ({ ctx: ctx2 }) => {
    const db = await getDb();
    if (!db) return [];
    const results = await db.select().from(notifications).where(
      and50(
        eq59(notifications.userId, ctx2.user.id),
        eq59(notifications.isRead, 0)
      )
    ).orderBy(desc18(notifications.createdAt));
    return results;
  }),
  /**
   * Get user's notifications with optional filtering
   */
  list: protectedProcedure.input(
    external_exports.object({
      limit: external_exports.number().default(20),
      offset: external_exports.number().default(0),
      unreadOnly: external_exports.boolean().default(false),
      category: external_exports.string().optional()
    })
  ).query(async ({ input, ctx: ctx2 }) => {
    const db = await getDb();
    if (!db) return [];
    const whereConditions = [eq59(notifications.userId, ctx2.user.id)];
    if (input.unreadOnly) {
      whereConditions.push(eq59(notifications.isRead, 0));
    }
    if (input.category) {
      whereConditions.push(eq59(notifications.type, input.category));
    }
    const results = await db.select().from(notifications).where(and50(...whereConditions)).orderBy(desc18(notifications.createdAt)).limit(input.limit).offset(input.offset);
    return results;
  }),
  /**
   * Get count of unread notifications
   */
  unreadCount: protectedProcedure.query(async ({ ctx: ctx2 }) => {
    const db = await getDb();
    if (!db) return 0;
    const result = await db.select().from(notifications).where(
      and50(
        eq59(notifications.userId, ctx2.user.id),
        eq59(notifications.isRead, 0)
      )
    );
    return result.length;
  }),
  /**
   * Mark notification as read
   */
  markAsRead: createFeatureRestrictedProcedure2("notifications:edit").input(external_exports.object({ id: external_exports.string() })).mutation(async ({ input, ctx: ctx2 }) => {
    const db = await getDb();
