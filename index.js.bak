        const monthTotal = allInvoices2.filter((inv) => inv.createdAt && new Date(inv.createdAt).toISOString().replace("T", " ").substring(0, 19).slice(0, 7) === monthKey).reduce((sum5, inv) => sum5 + (inv.total || 0), 0);
        monthlyRevenue.push(monthTotal);
