// server/routers/auditTrail.ts
init_trpc();
init_enhancedRbac();
init_zod();
init_db();
import { sql as sql30 } from "drizzle-orm";
var auditViewProcedure = createFeatureRestrictedProcedure("audit:view");
var auditEditProcedure = createFeatureRestrictedProcedure("audit:edit");
var auditTrailRouter = router({
  /**
   * Get activity log for a specific entity
   */
  getEntityActivityLog: auditViewProcedure.input(external_exports.object({
    entityType: external_exports.string(),
    entityId: external_exports.number(),
    limit: external_exports.number().min(1).max(100).default(20),
    offset: external_exports.number().min(0).default(0)
  }).strict()).query(async ({ input }) => {
    try {
      const db = await getDb();
      const [rows] = await db.execute(
        sql30`SELECT * FROM activityLog WHERE entityType = ${input.entityType} AND entityId = ${String(input.entityId)} ORDER BY createdAt DESC LIMIT ${input.limit} OFFSET ${input.offset}`
      );
      const [countResult] = await db.execute(
        sql30`SELECT COUNT(*) as total FROM activityLog WHERE entityType = ${input.entityType} AND entityId = ${String(input.entityId)}`
      );
      const total = countResult?.[0]?.total ?? 0;
      const activities = (rows || []).map((row) => ({
        id: row.id,
        timestamp: row.createdAt,
        userId: row.userId,
        userName: row.userId,
        action: row.action,
        description: row.description,
        changes: row.metadata ? JSON.parse(row.metadata) : null,
        ipAddress: row.ipAddress
      }));
      return {
        entityType: input.entityType,
        entityId: input.entityId,
        activities,
        total,
        offset: input.offset,
        limit: input.limit
      };
    } catch (error48) {
      console.error("Error in getEntityActivityLog:", error48);
      return { entityType: input.entityType, entityId: input.entityId, activities: [], total: 0, offset: input.offset, limit: input.limit };
    }
  }),
  /**
   * Get user activity timeline
   */
  getUserActivityTimeline: auditViewProcedure.input(external_exports.object({
    userId: external_exports.number(),
    dateRange: external_exports.object({
      start: external_exports.string(),
      end: external_exports.string()
    }).optional(),
    actionType: external_exports.string().optional(),
    limit: external_exports.number().min(1).max(100).default(30)
  }).strict()).query(async ({ input }) => {
    try {
      const db = await getDb();
      const conditions = [sql30`userId = ${String(input.userId)}`];
      if (input.dateRange) {
        conditions.push(sql30`createdAt >= ${input.dateRange.start}`);
        conditions.push(sql30`createdAt <= ${input.dateRange.end}`);
      }
      if (input.actionType) {
        conditions.push(sql30`action = ${input.actionType}`);
      }
      const whereClause = sql30`WHERE ${sql30.join(conditions, sql30` AND `)}`;
      const [rows] = await db.execute(
        sql30`SELECT * FROM activityLog ${whereClause} ORDER BY createdAt DESC LIMIT ${input.limit}`
      );
      const [statsRows] = await db.execute(
        sql30`SELECT COUNT(*) as totalActivities, MAX(createdAt) as lastActive FROM activityLog WHERE userId = ${String(input.userId)}`
      );
      const statsData = statsRows?.[0] || {};
      const [todayRows] = await db.execute(
        sql30`SELECT COUNT(*) as cnt FROM activityLog WHERE userId = ${String(input.userId)} AND createdAt >= CURDATE()`
      );
      const todaysActivities = todayRows?.[0]?.cnt ?? 0;
      const activities = (rows || []).map((row) => ({
        id: row.id,
        timestamp: row.createdAt,
        action: row.action,
        entityType: row.entityType,
        entityId: row.entityId,
        description: row.description,
        status: "success",
        duration: 0
      }));
      return {
        userId: input.userId,
        activities,
        stats: {
          totalActivities: Number(statsData.totalActivities || 0),
          todaysActivities: Number(todaysActivities),
          successRate: 100,
          lastActive: statsData.lastActive || null
        }
      };
    } catch (error48) {
      console.error("Error in getUserActivityTimeline:", error48);
      return { userId: input.userId, activities: [], stats: { totalActivities: 0, todaysActivities: 0, successRate: 0, lastActive: null } };
    }
  }),
  /**
   * Get change history for a record
   */
  getChangeHistory: auditViewProcedure.input(external_exports.object({
    entityType: external_exports.string(),
    entityId: external_exports.number()
  }).strict()).query(async ({ input }) => {
    try {
      const db = await getDb();
      const [rows] = await db.execute(
        sql30`SELECT * FROM activityLog WHERE entityType = ${input.entityType} AND entityId = ${String(input.entityId)} ORDER BY createdAt ASC`
      );
      const entries = rows || [];
      const versions = entries.map((row, idx) => ({
        version: idx + 1,
        timestamp: row.createdAt,
        changedBy: row.userId,
        action: row.action,
        description: row.description,
        changes: row.metadata ? JSON.parse(row.metadata) : {}
      }));
      return {
        entityType: input.entityType,
        entityId: input.entityId,
        versions,
        currentVersion: versions.length,
        totalVersions: versions.length
      };
    } catch (error48) {
      console.error("Error in getChangeHistory:", error48);
      return { entityType: input.entityType, entityId: input.entityId, versions: [], currentVersion: 0, totalVersions: 0 };
    }
  }),
  /**
   * Get audit trail summary and statistics
   */
  getAuditStatistics: auditViewProcedure.input(external_exports.object({
    dateRange: external_exports.object({
      start: external_exports.string(),
      end: external_exports.string()
    }).optional()
  }).strict()).query(async ({ input }) => {
    try {
      const db = await getDb();
      const dateFilter = input.dateRange ? sql30`WHERE createdAt >= ${input.dateRange.start} AND createdAt <= ${input.dateRange.end}` : sql30``;
      const [summaryRows] = await db.execute(
        sql30`SELECT COUNT(*) as totalActivities, COUNT(DISTINCT userId) as uniqueUsers FROM activityLog ${dateFilter}`
      );
      const summary = summaryRows?.[0] || {};
      const [byActionRows] = await db.execute(
        sql30`SELECT action, COUNT(*) as count FROM activityLog ${dateFilter} GROUP BY action ORDER BY count DESC`
      );
      const byAction = {};
      for (const row of byActionRows || []) {
        byAction[row.action] = Number(row.count);
