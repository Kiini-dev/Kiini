}
var readProc2 = createFeatureRestrictedProcedure2("hr:view");
var writeProc2 = createFeatureRestrictedProcedure2("hr:edit");
var leaveBalancesRouter = router({
  list: readProc2.input(external_exports.object({
    employeeId: external_exports.string().optional(),
    year: external_exports.number().optional(),
    leaveType: external_exports.string().optional()
  }).optional()).query(async ({ input }) => {
    try {
      const conds = [];
      const params = [];
      const year2 = input?.year || (/* @__PURE__ */ new Date()).getFullYear();
      conds.push("lb.year = ?");
      params.push(year2);
      if (input?.employeeId) {
        conds.push("lb.employeeId = ?");
        params.push(input.employeeId);
      }
      if (input?.leaveType) {
        conds.push("lb.leaveType = ?");
        params.push(input.leaveType);
      }
      const where = `WHERE ${conds.join(" AND ")}`;
      const [rows] = await pool8().query(
        `SELECT lb.*, CONCAT(e.firstName, ' ', e.lastName) as employeeName, e.department
           FROM leaveBalances lb
           LEFT JOIN employees e ON lb.employeeId = e.id
           ${where} ORDER BY e.firstName, lb.leaveType`,
        params
      );
      return rows;
    } catch (err) {
      console.error("leaveBalances.list error", err);
      return [];
    }
  }),
  byEmployee: readProc2.input(external_exports.object({ employeeId: external_exports.string(), year: external_exports.number().optional() })).query(async ({ input }) => {
    const year2 = input.year || (/* @__PURE__ */ new Date()).getFullYear();
    const [rows] = await pool8().query(
      `SELECT * FROM leaveBalances WHERE employeeId = ? AND year = ? ORDER BY leaveType`,
      [input.employeeId, year2]
    );
    return rows;
  }),
  update: writeProc2.input(external_exports.object({
    id: external_exports.string(),
    entitlement: external_exports.number().optional(),
    used: external_exports.number().optional(),
    pending: external_exports.number().optional(),
    carriedOver: external_exports.number().optional()
  })).mutation(async ({ input, ctx: ctx2 }) => {
    const sets = [];
