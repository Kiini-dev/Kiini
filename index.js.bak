// server/routers/activityTrail.ts
init_trpc();
init_zod();
init_db();
import { sql as sql27 } from "drizzle-orm";
var activityTrailRouter = router({
  list: protectedProcedure.input(external_exports.object({
    limit: external_exports.number().min(1).max(200).optional().default(50),
    offset: external_exports.number().min(0).optional().default(0),
    page: external_exports.number().min(1).optional(),
    userId: external_exports.number().optional(),
    entityType: external_exports.string().optional(),
    action: external_exports.string().optional(),
    startDate: external_exports.string().optional(),
    endDate: external_exports.string().optional(),
    search: external_exports.string().optional()
  }).optional()).query(async ({ input }) => {
    const db = await getDb();
    const params = input || {};
    const limit = params.limit ?? 50;
    const offset = params.page ? (params.page - 1) * limit : params.offset ?? 0;
    try {
      const conditions = [];
      if (params.userId) conditions.push(sql27`userId = ${params.userId}`);
      if (params.entityType) conditions.push(sql27`entityType = ${params.entityType}`);
      if (params.action) conditions.push(sql27`action = ${params.action}`);
      if (params.search) conditions.push(sql27`description LIKE ${`%${params.search}%`}`);
      if (params.startDate) conditions.push(sql27`createdAt >= ${params.startDate}`);
      if (params.endDate) conditions.push(sql27`createdAt <= ${params.endDate}`);
      const whereClause = conditions.length > 0 ? sql27`WHERE ${sql27.join(conditions, sql27` AND `)}` : sql27``;
      const [rows] = await db.execute(
        sql27`SELECT * FROM activityLog ${whereClause} ORDER BY createdAt DESC LIMIT ${limit} OFFSET ${offset}`
      );
      const [countResult] = await db.execute(
        sql27`SELECT COUNT(*) as total FROM activityLog ${whereClause}`
      );
      const total = countResult?.[0]?.total ?? 0;
      const activities = (rows || []).map((row) => ({
        ...row,
        timestamp: row.createdAt
      }));
      return { activities, total };
    } catch (err) {
      console.error("activityTrail.list error:", err);
      return { activities: [], total: 0 };
    }
  }),
  getStats: protectedProcedure.query(async () => {
    const db = await getDb();
    try {
      const [actionRows] = await db.execute(
        sql27`SELECT action, COUNT(*) as count FROM activityLog GROUP BY action ORDER BY count DESC LIMIT 10`
      );
      const actionStats = actionRows || [];
      const [summaryRows] = await db.execute(
        sql27`SELECT COUNT(*) as totalActivities, COUNT(DISTINCT userId) as uniqueUsers FROM activityLog`
      );
      const summary = summaryRows?.[0] || {};
      return {
        actions: actionStats,
        totalActivities: Number(summary.totalActivities || 0),
        successCount: Number(summary.totalActivities || 0),
        failedCount: 0,
        uniqueUsers: Number(summary.uniqueUsers || 0)
      };
    } catch {
      return { actions: [], totalActivities: 0, successCount: 0, failedCount: 0, uniqueUsers: 0 };
    }
  }),
  getEntityTypes: protectedProcedure.query(async () => {
    const db = await getDb();
    try {
      const [rows] = await db.execute(
        sql27`SELECT DISTINCT entityType FROM activityLog WHERE entityType IS NOT NULL ORDER BY entityType`
      );
      return (rows || []).map((r) => r.entityType).filter(Boolean);
    } catch {
      return [
        "invoice",
        "payment",
        "client",
        "employee",
        "project",
        "expense",
        "report",
        "system",
        "user",
        "payroll",
        "leave",
        "attendance"
      ];
    }
  }),
  getActions: protectedProcedure.query(async () => {
    const db = await getDb();
    try {
      const [rows] = await db.execute(
        sql27`SELECT DISTINCT action FROM activityLog ORDER BY action`
      );
      return (rows || []).map((r) => r.action).filter(Boolean);
    } catch {
      return [
        "created",
        "updated",
        "deleted",
        "approved",
        "rejected",
        "exported",
        "login",
        "logout",
        "sent",
        "viewed",
        "printed"
      ];
    }
  })
});

// server/routers/systemHealth.ts
init_trpc();
init_zod();
import os from "os";
import * as fs3 from "fs";
import * as path3 from "path";

// server/lib/metricsCollector.ts
var BUCKET_DURATION_MS = 6e4;
var MAX_BUCKETS = 60 * 24;
var buckets = [];
var activeConnections = 0;
var cacheHits = 0;
var cacheMisses = 0;
function getCurrentBucket() {
  const now = Date.now();
  const bucketTs = now - now % BUCKET_DURATION_MS;
  if (buckets.length === 0 || buckets[buckets.length - 1].timestamp !== bucketTs) {
    const bucket = {
      timestamp: bucketTs,
      requests: 0,
      errors: 0,
      totalResponseTime: 0,
      dbQueries: 0
    };
    buckets.push(bucket);
    if (buckets.length > MAX_BUCKETS) {
      buckets = buckets.slice(-MAX_BUCKETS);
    }
    return bucket;
  }
  return buckets[buckets.length - 1];
}
function getBucketsForPeriod(period) {
  const now = Date.now();
  const durations = {
    "1h": 60 * 6e4,
    "24h": 24 * 60 * 6e4,
    "7d": 7 * 24 * 60 * 6e4,
    "30d": 30 * 24 * 60 * 6e4
  };
  const cutoff = now - (durations[period] || durations["24h"]);
  return buckets.filter((b) => b.timestamp >= cutoff);
}
var metricsCollector = {
  recordRequest(responseTimeMs, isError2) {
    const bucket = getCurrentBucket();
    bucket.requests++;
    bucket.totalResponseTime += responseTimeMs;
    if (isError2) bucket.errors++;
  },
  recordDbQuery() {
    getCurrentBucket().dbQueries++;
  },
  recordCacheHit() {
    cacheHits++;
  },
  recordCacheMiss() {
    cacheMisses++;
  },
  incrementConnections() {
    activeConnections++;
  },
  decrementConnections() {
    activeConnections = Math.max(0, activeConnections - 1);
  },
  getMetrics(period = "24h") {
    const relevantBuckets = getBucketsForPeriod(period);
    if (relevantBuckets.length === 0) {
      return {
        requestsPerMinute: 0,
        averageResponseTime: 0,
        errorRate: 0,
        activeConnections,
        databaseQueries: 0,
        cacheHitRate: 0
      };
    }
    const totalRequests = relevantBuckets.reduce((s, b) => s + b.requests, 0);
    const totalErrors = relevantBuckets.reduce((s, b) => s + b.errors, 0);
    const totalResponseTime = relevantBuckets.reduce((s, b) => s + b.totalResponseTime, 0);
    const totalDbQueries = relevantBuckets.reduce((s, b) => s + b.dbQueries, 0);
    const minutesElapsed = Math.max(1, relevantBuckets.length);
    const totalCacheOps = cacheHits + cacheMisses;
    return {
      requestsPerMinute: Math.round(totalRequests / minutesElapsed),
      averageResponseTime: totalRequests > 0 ? Math.round(totalResponseTime / totalRequests) : 0,
      errorRate: totalRequests > 0 ? Math.round(totalErrors / totalRequests * 100 * 100) / 100 : 0,
      activeConnections,
      databaseQueries: totalDbQueries,
      cacheHitRate: totalCacheOps > 0 ? Math.round(cacheHits / totalCacheOps * 100 * 100) / 100 : 100
    };
  }
};

// server/routers/systemHealth.ts
var systemHealthRouter = router({
  getStatus: protectedProcedure.query(async () => {
    const uptime = process.uptime();
    const memUsage = process.memoryUsage();
    const cpus = os.cpus();
    const totalMem = os.totalmem();
    const freeMem = os.freemem();
    const loadAvg = os.loadavg();
    return {
      status: "healthy",
      uptime: Math.floor(uptime),
      uptimeFormatted: `${Math.floor(uptime / 86400)}d ${Math.floor(uptime % 86400 / 3600)}h ${Math.floor(uptime % 3600 / 60)}m`,
      memory: {
        heapUsed: Math.round(memUsage.heapUsed / 1024 / 1024),
        heapTotal: Math.round(memUsage.heapTotal / 1024 / 1024),
        rss: Math.round(memUsage.rss / 1024 / 1024),
        external: Math.round(memUsage.external / 1024 / 1024),
        systemTotal: Math.round(totalMem / 1024 / 1024),
        systemFree: Math.round(freeMem / 1024 / 1024),
        usagePercent: Math.round((totalMem - freeMem) / totalMem * 100)
      },
      cpu: {
        cores: cpus.length,
        model: cpus[0]?.model || "Unknown",
        loadAvg: loadAvg.map((l2) => Math.round(l2 * 100) / 100)
      },
      platform: os.platform(),
      nodeVersion: process.version,
      timestamp: (/* @__PURE__ */ new Date()).toISOString()
    };
  }),
  getComponents: protectedProcedure.query(async () => {
    const components = [];
    const serverUptime = process.uptime();
    const uptimePercent = Math.min(99.99, Math.round(serverUptime / (serverUptime + 1) * 100 * 100) / 100);
    components.push({
      name: "API Server",
      status: "operational",
      uptime: uptimePercent,
      responseTime: 1
      // This request itself is ~1ms
    });
    try {
      const { getDb: getDb2 } = await Promise.resolve().then(() => (init_db(), db_exports));
      const db = await getDb2();
      const start = Date.now();
      await db.execute(new (await import("drizzle-orm")).SQL(["SELECT 1"], []));
      const dbResponseTime = Date.now() - start;
      components.push({
        name: "Database",
        status: "operational",
        uptime: uptimePercent,
        responseTime: dbResponseTime
      });
    } catch {
      components.push({ name: "Database", status: "down", uptime: 0, responseTime: 0 });
    }
    try {
      const smtpHost = process.env.SMTP_HOST || process.env.EMAIL_HOST;
      const smtpUser = process.env.SMTP_USER || process.env.EMAIL_USER;
      if (smtpHost && smtpUser) {
        components.push({ name: "Email Service", status: "operational", uptime: uptimePercent, responseTime: 0 });
      } else {
        components.push({ name: "Email Service", status: "not_configured", uptime: 0, responseTime: 0 });
      }
    } catch {
      components.push({ name: "Email Service", status: "down", uptime: 0, responseTime: 0 });
    }
    const smsKey = process.env.AFRICASTALKING_API_KEY || process.env.SMS_API_KEY;
    if (smsKey) {
      components.push({ name: "SMS Service", status: "operational", uptime: uptimePercent, responseTime: 0 });
    } else {
      components.push({ name: "SMS Service", status: "not_configured", uptime: 0, responseTime: 0 });
    }
    try {
      const uploadDir = process.env.UPLOAD_DIR || path3.resolve(process.cwd(), "uploads");
      const start = Date.now();
      fs3.accessSync(uploadDir, fs3.constants.W_OK);
      components.push({
        name: "File Storage",
        status: "operational",
        uptime: uptimePercent,
        responseTime: Date.now() - start
      });
    } catch {
      components.push({ name: "File Storage", status: "degraded", uptime: 0, responseTime: 0 });
    }
    components.push({
      name: "Cache Layer",
      status: "operational",
      uptime: uptimePercent,
      responseTime: 0
    });
    return components;
  }),
  getMetrics: protectedProcedure.input(external_exports.object({ period: external_exports.enum(["1h", "24h", "7d", "30d"]).optional().default("24h") }).optional()).query(async ({ input }) => {
    const period = input?.period || "24h";
    return metricsCollector.getMetrics(period);
  })
});

