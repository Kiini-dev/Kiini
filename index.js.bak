          data: inv
        }))
      );
    }
    if (!input.modules || input.modules.includes("projects")) {
      const projectResults = await db.select().from(projects).where(like4(projects.name, searchTerm)).limit(input.limit);
      results.push(
        ...projectResults.map((p) => ({
          type: "project",
          id: p.id,
          title: p.name,
          description: p.description || "",
          data: p
        }))
      );
    }
