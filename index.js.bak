      const invoiceRecords = await database2.select().from(invoices);
      const bankBalance = bankTransactions3.reduce((sum5, p) => sum5 + (p.amount || 0), 0);
      const systemBalance = invoiceRecords.reduce((sum5, i) => sum5 + (i.total || 0), 0);
      const matched = bankTransactions3.filter(
        (p) => invoiceRecords.some(
          (i) => p.invoiceId && i.id === p.invoiceId || p.amount && i.total && Math.abs(p.amount - i.total) < 0.01
        )
      );
      const unmatched = bankTransactions3.filter(
        (p) => !matched.some((m) => m.id === p.id)
