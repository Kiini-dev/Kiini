    console.error("Database not available for email processing");
    return { success: false, processed: 0, failed: 0 };
  }
  try {
    const now = (/* @__PURE__ */ new Date()).toISOString().replace("T", " ").substring(0, 19);
    const pendingEmails = await db.select().from(emailQueue).where(
      or5(
        eq24(emailQueue.status, "pending"),
        and20(eq24(emailQueue.status, "retrying"), lte3(emailQueue.nextRetryAt, now))
      )
    ).limit(50);
    let processed = 0;
    let failed = 0;
    for (const email3 of pendingEmails) {
      try {
        const result = await sendEmail({
          to: email3.recipientEmail,
          subject: email3.subject,
          html: email3.htmlContent,
          text: email3.textContent || void 0
        });
        if (result.success) {
          await db.update(emailQueue).set({ status: "sent", sentAt: (/* @__PURE__ */ new Date()).toISOString().replace("T", " ").substring(0, 19) }).where(eq24(emailQueue.id, email3.id));
