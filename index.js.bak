          daysOverdue,
          manuallyTriggered: true
        }
      });
      if (!queueResult.success) {
        return { success: false, error: queueResult.error };
      }
      await recordReminderSent(invoice.id, input.reminderType, client.email, ctx2.user?.id);
      return {
