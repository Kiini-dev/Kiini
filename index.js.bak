function computeStatus(current, target, higherIsBetter = true) {
  const ratio = higherIsBetter ? current / target : target / current;
  if (ratio >= 0.95) return "success";
  if (ratio >= 0.75) return "warning";
  return "danger";
}
var kpiTrackingRouter = router({
