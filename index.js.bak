  invoiceMetrics: createFeatureRestrictedProcedure2("analytics:view").query(async () => {
    const db = await getDb();
    if (!db) return [];
    try {
      const metrics = await db.select({
        status: invoices.status,
        count: count4().as("count"),
        total: sum2(invoices.total).as("total"),
        average: sum2(invoices.total).divide(count4()).as("average")
      }).from(invoices).groupBy(invoices.status);
      return metrics;
    } catch (error48) {
      console.error("Invoice metrics error:", error48);
      return [];
    }
  }),
  /**
   * Get expense metrics by category
