      email: input.email,
      passwordHash,
      role: input.role,
      isActive: 1,
      organizationId: ctx2.user.organizationId,
      requiresPasswordChange: 0
    });
    const safeUser = newUser ? { id: newUser.id, email: newUser.email, name: newUser.name, role: newUser.role } : null;
    return { user: safeUser, success: true };
  }),
  /** Remove a user from the current org (org super_admin only) */
  removeOrgUser: protectedProcedure.input(external_exports.object({ userId: external_exports.string() })).mutation(async ({ input, ctx: ctx2 }) => {
    if (!ctx2.user.organizationId)
      throw new TRPCError2({ code: "FORBIDDEN" });
    if (ctx2.user.role !== "super_admin")
      throw new TRPCError2({ code: "FORBIDDEN", message: "Only organization administrators can remove staff" });
    if (input.userId === ctx2.user.id)
      throw new TRPCError2({ code: "BAD_REQUEST", message: "You cannot remove yourself" });
    const orgUsers = await getUsersByOrganization(ctx2.user.organizationId);
    const target = orgUsers.find((u) => u.id === input.userId);
    if (!target)
      throw new TRPCError2({ code: "NOT_FOUND", message: "User not found in your organization" });
    await assignUserToOrganization(input.userId, null);
    return { success: true };
  }),
  // ── Legacy stub procedures (EnterpriseSettings page compat) ───
  createTenant: enterpriseEditProcedure.input(external_exports.object({
