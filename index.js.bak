      return { totalPages: WEBSITE_PAGES.length, publishedPages: WEBSITE_PAGES.length, lastUpdated: (/* @__PURE__ */ new Date()).toISOString(), totalInquiries: 0, inquiriesByMonth: [], inquiriesByStatus: {} };
    }
    const [pageRows] = await pool12.query("SELECT value FROM systemSettings WHERE category = 'website_page'");
    const pageSettings = pageRows;
    let publishedCount = WEBSITE_PAGES.length;
    for (const s of pageSettings) {
      try {
        const val = JSON.parse(s.value || "{}");
        if (val.isPublished === false) publishedCount--;
      } catch {
      }
    }
    let totalInquiries = 0;
    let inquiriesByMonth = [];
    let inquiriesByStatus = { new: 0, read: 0, replied: 0, archived: 0 };
    try {
      const [countRows] = await pool12.query("SELECT COUNT(*) as total FROM websiteContacts");
      totalInquiries = countRows[0]?.total ?? 0;
      const [monthRows] = await pool12.query(
        "SELECT DATE_FORMAT(createdAt, '%Y-%m') as month, COUNT(*) as count FROM websiteContacts GROUP BY month ORDER BY month DESC LIMIT 12"
      );
      inquiriesByMonth = monthRows.reverse();
      const [statusRows] = await pool12.query(
        "SELECT COALESCE(status, 'new') as status, COUNT(*) as count FROM websiteContacts GROUP BY status"
      );
      for (const r of statusRows) {
        inquiriesByStatus[r.status] = r.count;
      }
    } catch {
    }
    return {
      totalPages: WEBSITE_PAGES.length,
      publishedPages: publishedCount,
      lastUpdated: (/* @__PURE__ */ new Date()).toISOString(),
      totalInquiries,
      inquiriesByMonth,
      inquiriesByStatus
    };
  }),
