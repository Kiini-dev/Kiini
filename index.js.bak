  /**
   * Get seasonal adjustment factors
   */
  getSeasonalAdjustments: forecastViewProcedure.input(external_exports.object({
    metric: external_exports.string().default("revenue")
  }).strict()).query(async ({ input }) => {
    try {
      const db = await getDb();
      const monthNames = [
        "January",
        "February",
        "March",
        "April",
        "May",
        "June",
        "July",
        "August",
        "September",
        "October",
        "November",
        "December"
      ];
      let seasonalFactors = [];
      if (db) {
        const source = input.metric === "expense" ? expenses : invoices;
        const allRecords = await db.select().from(source);
        const monthlyTotals = new Array(12).fill(0);
        const monthlyCounts = new Array(12).fill(0);
        allRecords.forEach((rec) => {
          if (rec.createdAt) {
            const month = new Date(rec.createdAt).getMonth();
            const amount = rec.total || rec.amount || 0;
            monthlyTotals[month] += amount;
            monthlyCounts[month]++;
          }
        });
        const monthlyAvgs = monthlyTotals.map((total, i) => monthlyCounts[i] > 0 ? total / monthlyCounts[i] : 0);
        const validAvgs = monthlyAvgs.filter((a) => a > 0);
        const overallAvg = validAvgs.length > 0 ? validAvgs.reduce((a, b) => a + b, 0) / validAvgs.length : 1;
        seasonalFactors = monthNames.map((name, i) => {
          const factor = overallAvg > 0 && monthlyAvgs[i] > 0 ? Math.round(monthlyAvgs[i] / overallAvg * 100) / 100 : 1;
          const pattern = factor > 1.05 ? "Above average period" : factor < 0.95 ? "Below average period" : "Near average";
          return { month: name, factor, pattern };
        });
      }
      if (seasonalFactors.length === 0 || seasonalFactors.every((f) => f.factor === 1)) {
        const defaultFactors = [0.92, 0.95, 0.98, 1.04, 1.08, 1.06, 1.02, 1, 1.05, 1.09, 1.1, 0.98];
        const defaultPatterns = [
          "Post-holiday slowdown",
          "Winter impact",
          "Spring recovery",
          "Q2 growth",
          "Peak season",
          "Strong period",
          "Summer slowdown",
          "Holiday period",
          "Back-to-school effect",
          "Peak season",
          "Holiday prep",
          "Year-end adjustments"
        ];
        seasonalFactors = monthNames.map((name, i) => ({
          month: name,
          factor: defaultFactors[i],
          pattern: defaultPatterns[i]
        }));
      }
      return {
        metric: input.metric,
        seasonalFactors,
        explanation: "Seasonal factors derived from historical monthly patterns. Apply to base forecasts for seasonal adjustment."
      };
    } catch (error48) {
      console.error("Error in getSeasonalAdjustments:", error48);
      throw new Error("Failed to fetch seasonal adjustments");
    }
  }),
