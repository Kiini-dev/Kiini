              nextRetryAt: nextRetry,
              errorMessage: result.error || "Send failed"
            }).where(eq24(emailQueue.id, email3.id));
            console.log(`[EMAIL QUEUE] Email ${email3.id} will retry at ${nextRetry}`);
          } else {
            await db.update(emailQueue).set({ status: "failed", errorMessage: result.error || "Max retries exceeded" }).where(eq24(emailQueue.id, email3.id));
            await db.insert(emailLog).values({
              id: v4_default(),
              queueId: email3.id,
              recipientEmail: email3.recipientEmail,
              subject: email3.subject,
              eventType: email3.eventType,
              status: "failed",
              errorMessage: result.error,
              sentAt: (/* @__PURE__ */ new Date()).toISOString().replace("T", " ").substring(0, 19)
            });
            console.log(`[EMAIL QUEUE] Email ${email3.id} to ${email3.recipientEmail} - FAILED after ${attempts} attempts`);
            failed++;
          }
        }
      } catch (error48) {
        console.error(`[EMAIL QUEUE] Error processing email ${email3.id}:`, error48);
        failed++;
