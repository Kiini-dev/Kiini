// server/routers/hrAutomation.ts
init_zod();
init_trpc();
init_trpc();
init_db();
init_dist();
var hrViewProcedure = createFeatureRestrictedProcedure2("hr:view");
var hrEditProcedure = createFeatureRestrictedProcedure2("hr:edit");
function pool11() {
  const p = getPool();
  if (!p) throw new TRPCError2({ code: "INTERNAL_SERVER_ERROR", message: "Database not available" });
  return p;
}
var hrAutomationRouter = router({
  // ── Automation Dashboard Stats ─────────────────────────────────
  getStats: hrViewProcedure.query(async () => {
    const p = pool11();
    const [expiringContracts] = await p.query(
      `SELECT COUNT(*) as count FROM employee_contracts
       WHERE status = 'active' AND end_date IS NOT NULL
       AND end_date BETWEEN CURDATE() AND DATE_ADD(CURDATE(), INTERVAL 30 DAY)`
    );
    const [pendingAccrual] = await p.query(
      `SELECT COUNT(DISTINCT employee_id) as count FROM leave_balances
       WHERE YEAR(created_at) = YEAR(CURDATE())`
    );
    const [pendingPayroll] = await p.query(
      `SELECT COUNT(*) as count FROM payroll WHERE status = 'draft'`
    );
    const [automationRules] = await p.query(
      `SELECT COUNT(*) as count FROM hr_automation_rules WHERE is_active = 1`
    );
    return {
      expiringContracts: expiringContracts[0]?.count || 0,
      pendingAccrual: pendingAccrual[0]?.count || 0,
      pendingPayroll: pendingPayroll[0]?.count || 0,
      activeRules: automationRules[0]?.count || 0
    };
  }),
  // ── Contract Expiry Alerts ─────────────────────────────────────
  getExpiringContracts: hrViewProcedure.input(external_exports.object({ days: external_exports.number().default(30) })).query(async ({ input }) => {
    const p = pool11();
    const [rows] = await p.query(
      `SELECT ec.*, e.first_name, e.last_name, e.email, e.department
         FROM employee_contracts ec
         LEFT JOIN employees e ON ec.employee_id = e.id
         WHERE ec.status = 'active' AND ec.end_date IS NOT NULL
         AND ec.end_date BETWEEN CURDATE() AND DATE_ADD(CURDATE(), INTERVAL ? DAY)
         ORDER BY ec.end_date ASC`,
      [input.days]
    );
    return rows;
  }),
  // ── Leave Accrual ──────────────────────────────────────────────
  runLeaveAccrual: hrEditProcedure.input(external_exports.object({
    leaveType: external_exports.string().default("annual"),
    accrualDays: external_exports.number().default(1.75),
    // ~21 days/year monthly
    year: external_exports.number().optional()
  })).mutation(async ({ input }) => {
    const p = pool11();
    const year2 = input.year || (/* @__PURE__ */ new Date()).getFullYear();
    const month = (/* @__PURE__ */ new Date()).getMonth() + 1;
    const [employees5] = await p.query(
      "SELECT id, first_name, last_name FROM employees WHERE status = 'active'"
    );
    let accrued = 0;
    for (const emp of employees5) {
      const [existing] = await p.query(
        `SELECT id FROM leave_balances
           WHERE employee_id = ? AND leave_type = ? AND YEAR(created_at) = ?
           AND MONTH(created_at) = ?`,
        [emp.id, input.leaveType, year2, month]
      );
      if (existing.length === 0) {
        const [balRow] = await p.query(
          `SELECT id, total_days, used_days FROM leave_balances
             WHERE employee_id = ? AND leave_type = ? AND YEAR(created_at) = YEAR(CURDATE())`,
          [emp.id, input.leaveType]
        );
        if (balRow.length > 0) {
          const bal = balRow[0];
          await p.query(
            "UPDATE leave_balances SET total_days = total_days + ? WHERE id = ?",
            [input.accrualDays, bal.id]
          );
        } else {
          const id = `lb_${Date.now()}_${Math.random().toString(36).slice(2, 7)}`;
          await p.query(
            `INSERT INTO leave_balances (id, employee_id, leave_type, total_days, used_days, year, created_at)
               VALUES (?, ?, ?, ?, 0, ?, NOW())`,
            [id, emp.id, input.leaveType, input.accrualDays, year2]
          );
        }
        accrued++;
      }
    }
    return { success: true, accrued, message: `Leave accrual completed for ${accrued} employees` };
  }),
  // ── Auto Payroll Generation ────────────────────────────────────
  generatePayroll: hrEditProcedure.input(external_exports.object({
    month: external_exports.number().min(1).max(12),
    year: external_exports.number()
  })).mutation(async ({ input }) => {
    const p = pool11();
    const period = `${input.year}-${String(input.month).padStart(2, "0")}`;
    const [existing] = await p.query(
      "SELECT id FROM payroll WHERE pay_period = ? LIMIT 1",
      [period]
    );
    if (existing.length > 0) {
      throw new TRPCError2({ code: "BAD_REQUEST", message: `Payroll for ${period} already exists` });
    }
    const [employees5] = await p.query(
      `SELECT e.id, e.first_name, e.last_name, e.email, e.department,
