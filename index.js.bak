    }
    return {
      ...results,
      message: `Sent ${results.sent} invoice(s), ${results.failed} failed`
    };
  }),
  // Batch send payment reminders
  batchSendPaymentReminders: createFeatureRestrictedProcedure2("communications:email").input(external_exports.object({
