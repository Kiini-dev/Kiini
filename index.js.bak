            monthlyMap.set(key, (monthlyMap.get(key) || 0) + (inv.total || 0));
          }
        });
        const sorted = Array.from(monthlyMap.entries()).sort();
        historicalData = sorted.map(([_2, v]) => v);
      }
      if (historicalData.length === 0) {
