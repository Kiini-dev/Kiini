  getAtRiskClients: readProcedure4.input(external_exports.object({ limit: external_exports.number().default(50) })).query(async ({ input }) => {
    const db = await getDb();
    if (!db) return { clients: [] };
    try {
      const scores = await db.getClientHealthScores({
        riskLevel: "red",
        limit: input.limit
      });
      const clients5 = [];
      for (const score of scores) {
        const client = await db.getClient(score.clientId);
        if (client) {
          clients5.push({
            ...client,
            healthScore: score
          });
        }
      }
      return { clients: clients5 };
    } catch (error48) {
      console.error("[CLIENT SCORING] Error getting at-risk clients:", error48);
      return { clients: [] };
    }
  }),
  /**
   * Get high-value clients
   */
  getHighValueClients: readProcedure4.input(external_exports.object({ minRevenue: external_exports.number().default(5e5), limit: external_exports.number().default(50) })).query(async ({ input }) => {
    const db = await getDb();
    if (!db) return { clients: [] };
    try {
      const scores = await db.getClientHealthScoresByRevenue(input.minRevenue, input.limit);
      const clients5 = [];
      for (const score of scores) {
        const client = await db.getClient(score.clientId);
        if (client) {
          clients5.push({
            ...client,
            healthScore: score
          });
        }
      }
      return { clients: clients5 };
    } catch (error48) {
      console.error("[CLIENT SCORING] Error getting high-value clients:", error48);
      return { clients: [] };
    }
  }),
  /**
   * Get churn risk analysis
   */
  getChurnRiskAnalysis: readProcedure4.query(async () => {
    const db = await getDb();
    if (!db) {
      return { veryHigh: 0, high: 0, medium: 0, low: 0, atRisk: [] };
    }
    try {
      const scores = await db.getClientHealthScores({ limit: 1e4 });
      let veryHigh = 0;
      let high = 0;
      let medium = 0;
      let low = 0;
      const atRisk = [];
      for (const score of scores) {
        if (score.churnRisk >= 75) {
          veryHigh++;
          if (atRisk.length < 20) {
            const client = await db.getClient(score.clientId);
            if (client) {
              atRisk.push({
                clientName: client.companyName,
                churnRisk: score.churnRisk,
                healthScore: score.healthScore,
                lastInvoice: await db.getLatestInvoice(score.clientId)
              });
            }
          }
        } else if (score.churnRisk >= 50) {
          high++;
        } else if (score.churnRisk >= 25) {
          medium++;
        } else {
          low++;
        }
      }
      return { veryHigh, high, medium, low, atRisk };
    } catch (error48) {
      console.error("[CLIENT SCORING] Error getting churn risk analysis:", error48);
      return { veryHigh: 0, high: 0, medium: 0, low: 0, atRisk: [] };
    }
  }),
  /**
   * Get growth trends for a client
   */
  getClientGrowthTrends: readProcedure4.input(external_exports.object({ clientId: external_exports.string(), months: external_exports.number().default(12) })).query(async ({ input }) => {
    const db = await getDb();
    if (!db) return { trends: [] };
    try {
      const trends = await db.getClientRevenueTrends(input.clientId, input.months);
      return { trends };
    } catch (error48) {
      console.error("[CLIENT SCORING] Error getting growth trends:", error48);
      return { trends: [] };
    }
  }),
  /**
   * Recalculate all client scores
   */
  refreshAllScores: readProcedure4.mutation(async ({ ctx: ctx2 }) => {
    if (ctx2.user?.role !== "admin" && ctx2.user?.role !== "super_admin") {
      throw new Error("Unauthorized - admin only");
    }
    const db = await getDb();
    if (!db) {
      return { success: false, updated: 0 };
    }
    try {
      const clients5 = await db.getClients({ limit: 1e4 });
      let updated = 0;
      for (const client of clients5) {
        await calculateClientHealthScore(client.id);
        updated++;
      }
      return { success: true, updated };
    } catch (error48) {
      console.error("[CLIENT SCORING] Error refreshing scores:", error48);
      return { success: false, error: String(error48) };
    }
  })
});

