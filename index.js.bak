    let seq = 0;
    if (result && result.length > 0 && result[0].num) {
      const match = result[0].num.match(/(\d+)$/);
      if (match) seq = parseInt(match[1]);
    }
    seq++;
    return `${prefix}-${String(seq).padStart(6, "0")}`;
  } catch (err) {
    console.warn("lpogenerator error", err);
    return `LPO-000001`;
  }
