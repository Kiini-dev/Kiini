// server/routers/payrollExport.ts
init_trpc();
init_zod();
init_db();
init_schema();
var ExcelJS2 = __toESM(require_excel(), 1);
import { eq as eq74, and as and63, gte as gte21, lte as lte20 } from "drizzle-orm";
var readProcedure14 = createFeatureRestrictedProcedure2("hr:payroll:view");
function calculateKenyanPayrollTaxes(basicSalary) {
  const salary = Math.round(basicSalary / 100);
  const personalRelief = 2400;
  let paye = 0;
  if (salary <= 24e3) {
    paye = Math.round(salary * 0.1 - personalRelief);
  } else if (salary <= 32333) {
    paye = Math.round(2400 + (salary - 24e3) * 0.15 - personalRelief);
  } else if (salary <= 5e5) {
    paye = Math.round(2400 + 1250 + (salary - 32333) * 0.2 - personalRelief);
  } else if (salary <= 8e5) {
    paye = Math.round(2400 + 1250 + 93333 + (salary - 5e5) * 0.25 - personalRelief);
  } else {
    paye = Math.round(2400 + 1250 + 93333 + 75e3 + (salary - 8e5) * 0.3 - personalRelief);
  }
  paye = Math.max(0, paye);
  const nssfTier1 = Math.min(Math.round(salary * 0.06), 18e3);
  const nssfTier2 = salary > 3e5 ? Math.round((salary - 3e5) * 0.06) : 0;
  const shif = Math.min(Math.round(salary * 0.025), 15e3);
  const housingLevy = Math.min(Math.round(salary * 0.015), 15e3);
  const totalDeductions = paye + nssfTier1 + nssfTier2 + shif + housingLevy;
  const netPay = salary - totalDeductions;
  return {
    salary,
    paye,
    nssfTier1,
    nssfTier2,
    nssf: nssfTier1 + nssfTier2,
    shif,
    housingLevy,
    totalDeductions,
    netPay
  };
}
var payrollExportRouter = router({
  /**
   * Export payroll data to Excel format
   */
  exportPayroll: readProcedure14.input(external_exports.object({
    startDate: external_exports.string(),
    endDate: external_exports.string(),
    employeeId: external_exports.string().optional(),
    departmentId: external_exports.string().optional(),
    format: external_exports.enum(["xlsx", "csv"]).default("xlsx")
  })).mutation(async ({ input, ctx: ctx2 }) => {
    const database2 = await getDb();
    if (!database2) throw new Error("Database not available");
    try {
      let query = database2.select({
        payrollId: payroll.id,
        employeeId: payroll.employeeId,
        employeeName: employees.firstName,
        employeeLast: employees.lastName,
        department: departments.departmentName,
        paymentDate: payroll.paymentDate,
        basicSalary: payroll.basicSalary,
        allowances: payroll.allowances,
        deductions: payroll.deductions,
        netPay: payroll.netPay,
        paymentMethod: payroll.paymentMethod,
        status: payroll.status
      }).from(payroll).leftJoin(employees, eq74(payroll.employeeId, employees.id)).leftJoin(departments, eq74(employees.departmentId, departments.id));
      const conditions = [
        gte21(payroll.paymentDate, input.startDate),
        lte20(payroll.paymentDate, input.endDate)
      ];
      if (input.employeeId) {
        conditions.push(eq74(payroll.employeeId, input.employeeId));
      }
      if (conditions.length > 0) {
        query = query.where(and63(...conditions));
      }
      const records = await query;
      if (!records || records.length === 0) {
        return {
          success: false,
          message: "No payroll records found for the specified criteria"
        };
      }
      const payrollData = records.map((record2) => {
        const taxes = calculateKenyanPayrollTaxes(record2.basicSalary);
        return {
          ...record2,
          ...taxes,
          employeeName: `${record2.employeeName || ""} ${record2.employeeLast || ""}`
        };
      });
      if (input.format === "xlsx") {
        const workbook = new ExcelJS2.Workbook();
        const worksheet = workbook.addWorksheet("Payroll");
        worksheet.columns = [
          { header: "Employee", key: "employeeName", width: 20 },
          { header: "Department", key: "department", width: 15 },
          { header: "Payment Date", key: "paymentDate", width: 12 },
          { header: "Basic Salary", key: "salary", width: 14 },
          { header: "Allowances", key: "allowances", width: 12 },
          { header: "PAYE", key: "paye", width: 10 },
          { header: "NSSF", key: "nssf", width: 10 },
          { header: "SHIF", key: "shif", width: 10 },
          { header: "Housing Levy", key: "housingLevy", width: 12 },
          { header: "Total Deductions", key: "totalDeductions", width: 14 },
          { header: "Net Pay", key: "netPay", width: 12 },
          { header: "Status", key: "status", width: 10 }
        ];
        const headerRow = worksheet.getRow(1);
        headerRow.font = { bold: true, color: { argb: "FFFFFFFF" } };
        headerRow.fill = { type: "pattern", pattern: "solid", fgColor: { argb: "FF1F4E78" } };
        headerRow.alignment = { horizontal: "center", vertical: "center" };
        payrollData.forEach((row) => {
          const sheetRow = worksheet.addRow({
            employeeName: row.employeeName,
            department: row.department || "N/A",
            paymentDate: row.paymentDate,
            salary: row.salary,
            allowances: row.allowances || 0,
            paye: row.paye,
            nssf: row.nssf,
            shif: row.shif,
            housingLevy: row.housingLevy,
            totalDeductions: row.totalDeductions,
            netPay: row.netPay,
            status: row.status
