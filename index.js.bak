    }
    if (!sets.length) return { success: true };
    params.push(input.id);
    await pool8().query(`UPDATE leaveBalances SET ${sets.join(", ")} WHERE id = ?`, params);
    await logActivity({ userId: ctx2.user.id, action: "leave_balance_updated", entityType: "leaveBalance", entityId: input.id, description: `Updated leave balance ${input.id}` });
    return { success: true };
  }),
  allocate: writeProc2.input(external_exports.object({
    employeeId: external_exports.string(),
    leaveType: external_exports.enum(["annual", "sick", "maternity", "paternity", "compassionate", "unpaid", "study"]),
    year: external_exports.number(),
    entitlement: external_exports.number(),
    carriedOver: external_exports.number().optional()
  })).mutation(async ({ input, ctx: ctx2 }) => {
    const id = v4_default();
    await pool8().query(
