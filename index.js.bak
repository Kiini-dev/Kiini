    if (!input.modules || input.modules.includes("clients")) {
      const clientResults = await db.select().from(clients).where(
        or3(
          like4(clients.companyName, searchTerm),
          like4(clients.email, searchTerm),
          like4(clients.phone, searchTerm)
        )
      ).limit(input.limit);
      results.push(
        ...clientResults.map((c) => ({
          type: "client",
          id: c.id,
          title: c.companyName,
          description: c.email,
