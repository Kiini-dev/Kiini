        message: `Stock adjusted by ${input.quantityChange} units`
      };
    } catch (error48) {
      console.error("Error adjusting stock:", error48);
      throw new TRPCError2({
        code: "INTERNAL_SERVER_ERROR",
        message: error48 instanceof Error ? error48.message : "Failed to adjust stock"
      });
    }
  }),
  /**
   * Get low stock items (below reorder level)
   */
  getLowStockItems: publicProcedure.query(async ({ ctx: ctx2 }) => {
    try {
      const database2 = await getDb();
      if (!database2) {
        throw new TRPCError2({ code: "INTERNAL_SERVER_ERROR", message: "Database connection failed" });
      }
      const lowStockItems = await database2.select().from(products).catch(() => []);
      return (lowStockItems || []).filter((item) => (item.stockQuantity || 0) <= (item.reorderPoint || 0)).map((item) => ({
        id: item.id,
        sku: item.sku,
        productName: item.name,
        category: item.category,
        quantity: item.stockQuantity || 0,
        reorderLevel: item.reorderPoint || 0,
        toOrder: Math.max(0, (item.reorderPoint || 0) - (item.stockQuantity || 0)),
        unitCost: item.unitPrice || 0
      })).sort((a, b) => a.quantity - b.quantity);
    } catch (error48) {
      console.error("Error fetching low stock items:", error48);
      return [];
    }
  }),
  /**
   * Get inventory value report
   */
  getInventoryValue: publicProcedure.query(async ({ ctx: ctx2 }) => {
    try {
      const database2 = await getDb();
      if (!database2) {
        throw new TRPCError2({ code: "INTERNAL_SERVER_ERROR", message: "Database connection failed" });
      }
      const productsData = await database2.select().from(products).catch(() => []);
      const items = (productsData || []).map((item) => ({
        id: item.id,
        name: item.name,
        quantity: item.stockQuantity || 0,
        unitPrice: item.unitPrice || 0,
        totalValue: (item.stockQuantity || 0) * (item.unitPrice || 0) / 100,
        category: item.category
      }));
      const totalValue = items.reduce((sum5, item) => sum5 + item.totalValue, 0);
      const byCategory = items.reduce(
        (acc, item) => {
          acc[item.category] = (acc[item.category] || 0) + item.totalValue;
          return acc;
        },
        {}
      );
      return {
        totalValue,
        totalItems: items.length,
        byCategory,
        items
      };
    } catch (error48) {
      console.error("Error calculating inventory value:", error48);
      throw new TRPCError2({
        code: "INTERNAL_SERVER_ERROR",
        message: "Failed to calculate inventory value"
      });
    }
  }),
  /**
   * Bulk adjust stock from CSV import
   */
  bulkAdjust: publicProcedure.input(
    external_exports.object({
      adjustments: external_exports.array(
        external_exports.object({
          productId: external_exports.string(),
          quantityChange: external_exports.number().int(),
          reason: external_exports.string()
        })
      )
    })
  ).mutation(async ({ ctx: ctx2, input }) => {
    try {
      const database2 = await getDb();
      if (!database2) {
        throw new TRPCError2({ code: "INTERNAL_SERVER_ERROR", message: "Database connection failed" });
      }
      const results = [];
      for (const adjustment of input.adjustments) {
        try {
          const product = await database2.select().from(products).where(eq83(products.id, adjustment.productId)).limit(1).then((result) => result[0] || null).catch(() => null);
          if (!product) {
            results.push({
              productId: adjustment.productId,
              success: false,
              error: "Product not found"
            });
            continue;
          }
          const newQuantity = Math.max(0, (product.stockQuantity || 0) + adjustment.quantityChange);
          await database2.update(products).set({
            stockQuantity: newQuantity,
            updatedAt: (/* @__PURE__ */ new Date()).toISOString().replace("T", " ").substring(0, 19).split("T")[0]
          }).where(eq83(products.id, adjustment.productId));
          results.push({
            productId: adjustment.productId,
            productName: product.name,
            success: true,
            oldQuantity: product.stockQuantity || 0,
            newQuantity
          });
        } catch (error48) {
          results.push({
            productId: adjustment.productId,
            success: false,
            error: error48 instanceof Error ? error48.message : "Unknown error"
          });
        }
      }
      await logActivity({
        userId: ctx2.user?.id || "system",
        action: "inventory_bulk_adjusted",
        description: `Bulk adjusted ${results.filter((r) => r.success).length}/${input.adjustments.length} items`,
        entityType: "inventory",
        entityId: "bulk"
      });
      return {
        success: true,
        totalAdjustments: input.adjustments.length,
        successCount: results.filter((r) => r.success).length,
        results
      };
    } catch (error48) {
      console.error("Error bulk adjusting stock:", error48);
      throw new TRPCError2({
        code: "INTERNAL_SERVER_ERROR",
        message: "Failed to bulk adjust stock"
      });
    }
  })
});

