// server/routers/analytics.ts
init_trpc();
init_zod();
init_db();
init_schema();
import { eq as eq58, gte as gte10, lte as lte10, and as and49, count as count4, sum as sum2 } from "drizzle-orm";
var analyticsRouter = router({
  /**
   * Get financial summary metrics
   */
  financialSummary: createFeatureRestrictedProcedure2("analytics:view").input(
    external_exports.object({
      dateFrom: external_exports.string().optional(),
      dateTo: external_exports.string().optional()
    })
  ).query(async ({ input }) => {
    const db = await getDb();
    if (!db) return null;
    try {
      const conditions = [];
      if (input.dateFrom) {
        conditions.push(gte10(invoices.issueDate, input.dateFrom));
      }
      if (input.dateTo) {
        conditions.push(lte10(invoices.issueDate, input.dateTo));
      }
      const invoiceStats = await db.select({
        status: invoices.status,
        count: count4().as("count"),
        total: sum2(invoices.total).as("total")
      }).from(invoices).where(conditions.length > 0 ? and49(...conditions) : void 0).groupBy(invoices.status);
      const expenseStats = await db.select({
        status: expenses.status,
        count: count4().as("count"),
        total: sum2(expenses.amount).as("total")
      }).from(expenses).groupBy(expenses.status);
      const totalInvoiced = invoiceStats.reduce(
        (sum5, s) => sum5 + parseFloat(s.total || "0"),
        0
      );
      const totalPaid = invoiceStats.filter((s) => s.status === "paid").reduce((sum5, s) => sum5 + parseFloat(s.total || "0"), 0);
      const totalOutstanding = totalInvoiced - totalPaid;
      const totalExpenses = expenseStats.reduce(
        (sum5, s) => sum5 + parseFloat(s.total || "0"),
        0
      );
      return {
        totalInvoiced,
        totalPaid,
        totalOutstanding,
        totalExpenses,
        netProfit: totalPaid - totalExpenses,
        invoiceStats,
        expenseStats
      };
    } catch (error48) {
      console.error("Financial summary error:", error48);
      return null;
    }
  }),
  /**
   * Get revenue trends over time
