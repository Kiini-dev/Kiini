           LIMIT ?` : `SELECT m.*
           FROM staffChatMessages m
           LEFT JOIN chat_read_status crs
             ON crs.user_id = ? AND crs.channel_id = m.channelId
           WHERE m.userId != ?
             AND (crs.last_read_message_id IS NULL OR m.id > crs.last_read_message_id)
           ORDER BY m.createdAt DESC
