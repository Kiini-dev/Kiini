var writeProcedure5 = createFeatureRestrictedProcedure2("permissions:edit");
var enhancedPermissionsRouter = router({
  /**
   * List all permissions with metadata
   */
  list: readProcedure11.query(async () => {
    const db = await getDb();
    if (!db) return [];
    const permissions3 = await db.select().from(permissionMetadata);
    return permissions3.map((p) => ({
      id: p.permissionId,
      label: p.label,
      description: p.description,
      category: p.category,
      icon: p.icon,
      isSystem: !!p.isSystem
    }));
  }),
  /**
   * Get permissions by category
   */
  getByCategory: readProcedure11.input(external_exports.string()).query(async ({ input: category }) => {
    const db = await getDb();
    if (!db) return [];
    const permissions3 = await db.select().from(permissionMetadata).where(eq67(permissionMetadata.category, category));
    return permissions3.map((p) => ({
      id: p.permissionId,
      label: p.label,
      description: p.description,
      category: p.category,
      icon: p.icon,
      isSystem: !!p.isSystem
    }));
  }),
  /**
   * Get all permission categories
   */
  getCategories: readProcedure11.query(async () => {
    const db = await getDb();
    if (!db) return [];
    const permissions3 = await db.select().from(permissionMetadata);
    const categories = [...new Set(permissions3.map((p) => p.category))];
    return categories.sort();
  }),
  /**
   * Get permission details
   */
  getDetail: readProcedure11.input(external_exports.string()).query(async ({ input: permissionId }) => {
    const db = await getDb();
    if (!db) return null;
    const permission = await db.select().from(permissionMetadata).where(eq67(permissionMetadata.permissionId, permissionId));
    if (!permission || permission.length === 0) return null;
    const p = permission[0];
    return {
      id: p.permissionId,
      label: p.label,
      description: p.description,
      category: p.category,
      icon: p.icon,
      isSystem: !!p.isSystem
    };
  }),
  /**
   * Search permissions by label or description
   */
  search: readProcedure11.input(external_exports.string()).query(async ({ input: query }) => {
    const db = await getDb();
    if (!db) return [];
    const permissions3 = await db.select().from(permissionMetadata).where(
      or7(
        like6(permissionMetadata.label, `%${query}%`),
        like6(permissionMetadata.description, `%${query}%`)
      )
    );
    return permissions3.map((p) => ({
      id: p.permissionId,
      label: p.label,
      description: p.description,
      category: p.category,
      icon: p.icon,
      isSystem: !!p.isSystem
    }));
  }),
  /**
   * Get permissions for a role
   */
  getForRole: readProcedure11.input(external_exports.string()).query(async ({ input: roleId }) => {
    const db = await getDb();
    if (!db) return [];
    const rolePerms = await db.select().from(rolePermissions).where(eq67(rolePermissions.roleId, roleId));
    const permIds = rolePerms.map((rp) => rp.permissionId).filter(Boolean);
    if (permIds.length === 0) return [];
    const permissions3 = await db.select().from(permissionMetadata).where(
      permissionMetadata.permissionId.inList ? permissionMetadata.permissionId.inList(permIds) : or7(...permIds.map((id) => eq67(permissionMetadata.permissionId, id)))
    );
    return permissions3.map((p) => ({
      id: p.permissionId,
      label: p.label,
      description: p.description,
      category: p.category,
      icon: p.icon,
      isSystem: !!p.isSystem
    }));
  }),
  /**
   * Assign permission to role
   */
  assignToRole: writeProcedure5.input(
    external_exports.object({
      roleId: external_exports.string(),
      permissionId: external_exports.string()
    })
  ).mutation(async ({ input, ctx: ctx2 }) => {
    const db = await getDb();
    if (!db) throw new Error("Database not available");
    const existing = await db.select().from(rolePermissions).where(
      and58(
        eq67(rolePermissions.roleId, input.roleId),
        eq67(rolePermissions.permissionId, input.permissionId)
      )
    );
    if (existing && existing.length > 0) {
      return { success: false, message: "Permission already assigned" };
    }
    const permDetail = await db.select().from(permissionMetadata).where(eq67(permissionMetadata.permissionId, input.permissionId));
    await db.insert(rolePermissions).values({
      id: v4_default(),
      roleId: input.roleId,
      permissionId: input.permissionId,
      createdAt: (/* @__PURE__ */ new Date()).toISOString().replace("T", " ").substring(0, 19)
    });
    const permLabel = permDetail && permDetail.length > 0 ? permDetail[0].label : input.permissionId;
    await db.insert(permissionAuditLog).values({
      id: v4_default(),
      roleId: input.roleId,
      permissionId: input.permissionId,
      permissionLabel: permLabel,
      action: "assign",
      changedBy: ctx2.user.id,
      newValue: "assigned",
      createdAt: (/* @__PURE__ */ new Date()).toISOString().replace("T", " ").substring(0, 19)
    });
    return { success: true, message: "Permission assigned successfully" };
  }),
  /**
   * Remove permission from role
   */
  removeFromRole: writeProcedure5.input(
    external_exports.object({
      roleId: external_exports.string(),
      permissionId: external_exports.string()
    })
  ).mutation(async ({ input, ctx: ctx2 }) => {
    const db = await getDb();
    if (!db) throw new Error("Database not available");
    const permDetail = await db.select().from(permissionMetadata).where(eq67(permissionMetadata.permissionId, input.permissionId));
    await db.delete(rolePermissions).where(
      and58(
        eq67(rolePermissions.roleId, input.roleId),
        eq67(rolePermissions.permissionId, input.permissionId)
      )
    );
    const permLabel = permDetail && permDetail.length > 0 ? permDetail[0].label : input.permissionId;
    await db.insert(permissionAuditLog).values({
      id: v4_default(),
      roleId: input.roleId,
      permissionId: input.permissionId,
      permissionLabel: permLabel,
      action: "remove",
      changedBy: ctx2.user.id,
      oldValue: "assigned",
      createdAt: (/* @__PURE__ */ new Date()).toISOString().replace("T", " ").substring(0, 19)
    });
    return { success: true, message: "Permission removed successfully" };
  }),
  /**
   * Get audit log for permissions
   */
  getAuditLog: readProcedure11.input(
    external_exports.object({
      roleId: external_exports.string().optional(),
      limit: external_exports.number().default(100),
      offset: external_exports.number().default(0)
    })
  ).query(async ({ input }) => {
    const db = await getDb();
    if (!db) return [];
    let query = db.select().from(permissionAuditLog);
    if (input.roleId) {
      query = query.where(eq67(permissionAuditLog.roleId, input.roleId));
    }
    const logs = await query.limit(input.limit).offset(input.offset);
    return logs;
  })
});
function or7(...conditions) {
  if (conditions.length === 0) return void 0;
  if (conditions.length === 1) return conditions[0];
  return conditions.reduce((acc, cond) => ({ ...acc, ...cond }));
}

