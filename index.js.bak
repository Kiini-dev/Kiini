  projectStatusDistribution: createFeatureRestrictedProcedure2("analytics:view").query(async () => {
    const db = await getDb();
    if (!db) return [];
    try {
      const distribution = await db.select({
        status: projects.status,
        count: count4().as("count")
      }).from(projects).groupBy(projects.status);
      return distribution;
    } catch (error48) {
      console.error("Project status distribution error:", error48);
      return [];
    }
  }),
  /**
   * Get client distribution metrics
