          if (attempts < (email3.maxAttempts || 3)) {
            const backoffMs = Math.pow(5, attempts) * 6e4;
            const nextRetry = new Date(Date.now() + backoffMs).toISOString().replace("T", " ").substring(0, 19);
            await db.update(emailQueue).set({
              status: "retrying",
