      await rawQuery(
        `INSERT INTO lpos (id, lpoNumber, vendorName, vendorId, description, items, totalAmount, budgetLine, expectedDelivery, terms, status, createdBy, createdAt, updatedAt)
           VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,
        [
          id,
          lpoNumber,
          input.vendorName,
          input.vendorId || null,
          input.description,
          JSON.stringify(input.items),
          input.totalAmount,
          input.budgetLine || null,
          input.expectedDelivery || null,
          input.terms || null,
          input.status,
          ctx2.user?.id || "system",
          now,
          now
        ]
      );
      await rawQuery(
        `INSERT INTO activity_logs (id, userId, action, entityType, entityId, description, createdAt)
           VALUES (?, ?, ?, ?, ?, ?, ?)`,
        [v4_default(), ctx2.user?.id || "system", "CREATE_LPO", "LPO", id, `Created LPO ${lpoNumber}`, now]
      );
      return { id, lpoNumber, success: true };
    } catch (error48) {
      console.error("LPO create error:", error48);
      throw new TRPCError2({ code: "INTERNAL_SERVER_ERROR", message: "Failed to create LPO" });
    }
  }),
  lpoUpdate: writeProcedure11.input(external_exports.object({
    id: external_exports.string(),
    vendorName: external_exports.string().optional(),
    description: external_exports.string().optional(),
    items: external_exports.array(external_exports.object({
      description: external_exports.string(),
      quantity: external_exports.number().positive(),
      unitPrice: external_exports.number().positive(),
