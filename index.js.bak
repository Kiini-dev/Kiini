      await assignUserToOrganization(input.existingUserId, input.organizationId);
      const database2 = await getDb();
      if (database2) {
        const { users: users6 } = await Promise.resolve().then(() => (init_schema(), schema_exports));
        const { eq: eq147 } = await import("drizzle-orm");
        await database2.update(users6).set({ role: "super_admin" }).where(eq147(users6.id, input.existingUserId));
      }
      return { success: true, adminUserId: input.existingUserId };
    }
    if (input.adminEmail) {
      const { getUserByEmail: getUserByEmail2, createUser: createUser2 } = await Promise.resolve().then(() => (init_db_users(), db_users_exports));
      const existing = await getUserByEmail2(input.adminEmail);
      if (existing) {
        await assignUserToOrganization(existing.id, input.organizationId);
        return { success: true, adminUserId: existing.id };
      }
      if (!input.adminName || !input.adminPassword)
        throw new TRPCError2({ code: "BAD_REQUEST", message: "Name and password required for new admin" });
      const bcrypt = await Promise.resolve().then(() => (init_bcryptjs(), bcryptjs_exports));
      const salt = await bcrypt.genSalt(10);
      const passwordHash = await bcrypt.hash(input.adminPassword, salt);
      const userId = `user_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;
      await createUser2({
        id: userId,
        name: input.adminName,
        email: input.adminEmail,
        passwordHash,
        role: "super_admin",
        isActive: 1,
        organizationId: input.organizationId,
        requiresPasswordChange: 0
      });
      return { success: true, adminUserId: userId };
    }
    return { success: true };
  }),
  // ── Member Management ───────────────────────────────────────────
  listOrganizationMembers: enterpriseViewProcedure.input(
    external_exports.object({
      organizationId: external_exports.string().optional(),
      includeInactive: external_exports.boolean().default(false)
    }).optional()
  ).query(async ({ input, ctx: ctx2 }) => {
    const database2 = await getDb();
    if (!database2) return { members: [] };
    const { organizationMembers: organizationMembers2 } = await Promise.resolve().then(() => (init_schema_extended(), schema_extended_exports));
    const { users: users6, organizations: organizations2 } = await Promise.resolve().then(() => (init_schema(), schema_exports));
    const { eq: eq147, desc: desc86 } = await import("drizzle-orm");
    const rows = await database2.select({
      membershipId: organizationMembers2.id,
      organizationId: organizationMembers2.organizationId,
      memberRole: organizationMembers2.role,
      memberStatus: organizationMembers2.status,
      memberIsActive: organizationMembers2.isActive,
      joinedAt: organizationMembers2.joinedAt,
      leftAt: organizationMembers2.leftAt,
      createdAt: organizationMembers2.createdAt,
      userId: users6.id,
      userName: users6.name,
      userEmail: users6.email,
      userRole: users6.role,
      organizationName: organizations2.name,
      organizationSlug: organizations2.slug
    }).from(organizationMembers2).leftJoin(users6, eq147(organizationMembers2.userId, users6.id)).leftJoin(organizations2, eq147(organizationMembers2.organizationId, organizations2.id)).orderBy(desc86(organizationMembers2.createdAt)).limit(2e3);
    const scopedOrgId = ctx2.user.organizationId || input?.organizationId;
    const filtered = rows.filter((row) => {
      if (scopedOrgId && row.organizationId !== scopedOrgId) return false;
      if (!input?.includeInactive && !row.memberIsActive) return false;
      return true;
    });
    return { members: filtered };
  }),
  getOrgUsers: enterpriseViewProcedure.input(external_exports.object({ organizationId: external_exports.string() })).query(async ({ input, ctx: ctx2 }) => {
    if (!checkOrgScopeAccess(ctx2, input.organizationId)) {
      throw new TRPCError2({ code: "FORBIDDEN", message: "You can only access your own organization" });
    }
    const orgUsers = await getUsersByOrganization(input.organizationId);
    const safe = orgUsers.map(({ passwordHash, passwordResetToken, ...u }) => u);
    return { users: safe };
  }),
  assignUserToOrg: enterpriseEditProcedure.input(external_exports.object({ userId: external_exports.string(), organizationId: external_exports.string().nullable() })).mutation(async ({ input, ctx: ctx2 }) => {
    if (input.organizationId && !checkOrgScopeAccess(ctx2, input.organizationId)) {
      throw new TRPCError2({ code: "FORBIDDEN", message: "You can only assign users within your own organization" });
    }
    if (!input.organizationId && ctx2.user.organizationId) {
      throw new TRPCError2({ code: "FORBIDDEN", message: "Organization administrators cannot unassign users globally" });
    }
    await assignUserToOrganization(input.userId, input.organizationId);
    return { success: true };
  }),
  // ── Tenant Admin Management ─────────────────────────────────────
  listTenantAdmins: enterpriseViewProcedure.query(async ({ ctx: ctx2 }) => {
    let admins = await getAllTenantSuperAdmins();
    if (ctx2.user.organizationId) {
      admins = admins.filter((admin) => admin.organizationId === ctx2.user.organizationId);
    }
    const enriched = await Promise.all(
      admins.map(async (admin) => {
