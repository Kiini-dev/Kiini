        renewalDate.setFullYear(renewalDate.getFullYear() + 1);
      }
      const plan = await getPricingPlan(orgData.plan);
      const price = billingCycle === "monthly" ? plan?.monthlyPrice || 0 : plan?.annualPrice || 0;
      const subscription = await createSubscription({
        id: subscriptionId,
        organizationId: orgId,
        planId: orgData.plan,
        status: "trial",
        billingCycle,
        startDate: now.toISOString().replace("T", " ").substring(0, 19),
        renewalDate: renewalDate.toISOString().replace("T", " ").substring(0, 19),
