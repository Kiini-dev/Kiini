      function write_ws_bin(idx, opts, wb, rels) {
        var ba = buf_array();
        var s = wb.SheetNames[idx], ws = wb.Sheets[s] || {};
        var c = s;
        try {
          if (wb && wb.Workbook) c = wb.Workbook.Sheets[idx].CodeName || c;
        } catch (e) {
        }
