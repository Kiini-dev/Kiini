      return result?.[0] || null;
    } catch (error48) {
      console.error("LPO getById error:", error48);
      return null;
    }
  }),
  lpoCreate: writeProcedure11.input(lpoCreateSchema).mutation(async ({ input, ctx: ctx2 }) => {
