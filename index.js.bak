        const totalSalary = payrollData.reduce((sum5, row) => sum5 + row.salary, 0);
        const totalPAYE = payrollData.reduce((sum5, row) => sum5 + row.paye, 0);
        const totalNSSF = payrollData.reduce((sum5, row) => sum5 + row.nssf, 0);
        const totalSHIF = payrollData.reduce((sum5, row) => sum5 + row.shif, 0);
        const totalHousing = payrollData.reduce((sum5, row) => sum5 + row.housingLevy, 0);
        const totalDeductions = payrollData.reduce((sum5, row) => sum5 + row.totalDeductions, 0);
        const totalNetPay = payrollData.reduce((sum5, row) => sum5 + row.netPay, 0);
        worksheet.addRow({});
        worksheet.addRow({
