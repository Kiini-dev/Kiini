import { eq as eq20, desc as desc7, and as and16 } from "drizzle-orm";
var viewProcedure3 = createFeatureRestrictedProcedure("accounting:payments:view");
var createProcedure4 = createFeatureRestrictedProcedure("accounting:payments:create");
var approveProcedure2 = createFeatureRestrictedProcedure("accounting:payments:approve");
var deleteProcedure4 = createRoleRestrictedProcedure(["super_admin", "admin"]);
async function generateNextPaymentReferenceNumber(database2) {
  try {
    const result = await database2.select({ payNum: payments.referenceNumber }).from(payments).orderBy(desc7(payments.referenceNumber)).limit(1);
    let maxSequence = 0;
    if (result && result.length > 0 && result[0].payNum) {
      const match = result[0].payNum.match(/(\d+)$/);
      if (match) {
        maxSequence = parseInt(match[1]);
      }
    }
    const nextSequence = maxSequence + 1;
    return `PAY-${String(nextSequence).padStart(6, "0")}`;
  } catch (err) {
    console.warn("Error generating payment reference number, using default:", err);
    return `PAY-000001`;
  }
}
async function sendPaymentNotification(database2, userId, action, amount, invoiceNumber, paymentId) {
  try {
    const amountFormatted = (amount / 100).toLocaleString("en-KE", {
      style: "currency",
      currency: "KES"
    });
    const messages2 = {
      recorded: `Payment of ${amountFormatted} received for invoice ${invoiceNumber}`,
      approved: `Payment of ${amountFormatted} for invoice ${invoiceNumber} has been approved`
    };
    const titles = {
      recorded: "Payment Recorded",
      approved: "Payment Approved"
    };
    await createNotification({
      userId,
      title: titles[action],
      message: messages2[action],
      type: "success",
      category: "payment",
      entityType: "payment",
      entityId: paymentId,
      actionUrl: `/payments/${paymentId}`,
      priority: "normal"
    });
  } catch (err) {
    console.warn("Failed to create payment notification:", err);
  }
}
var paymentsRouter = router({
  list: viewProcedure3.input(external_exports.object({ limit: external_exports.number().optional(), offset: external_exports.number().optional() }).optional()).query(async ({ input, ctx: ctx2 }) => {
    try {
