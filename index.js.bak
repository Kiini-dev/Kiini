  });
  emailQueueJob.start();
  overdueRemindersJob.start();
  billingLockJob.start();
  billingNotificationsJob.start();
  usageReminderJob.start();
  recurringInvoicesJob.start();
  recurringExpensesJob.start();
  hrAutomationJob.start();
  console.log("[SCHEDULER] Background jobs started:");
  console.log("  - Email queue processor: Every 5 minutes");
  console.log("  - Overdue invoice reminders: Daily at 09:00 AM");
  console.log("  - Subscription lockout check: Daily at 00:01 AM");
  console.log("  - Billing notifications: Daily at 08:00 AM");
  console.log("  - Usage reminders: Weekly on Monday at 10:00 AM");
  console.log("  - Recurring invoices: Daily at 06:00 AM");
  console.log("  - Recurring expenses: Daily at 06:30 AM");
  console.log("  - HR automation rules: Daily at 07:00 AM");
  process.on("SIGTERM", () => {
    console.log("[SCHEDULER] Stopping background jobs...");
    emailQueueJob.stop();
    overdueRemindersJob.stop();
    billingLockJob.stop();
    billingNotificationsJob.stop();
    usageReminderJob.stop();
    recurringInvoicesJob.stop();
    recurringExpensesJob.stop();
    hrAutomationJob.stop();
    process.exit(0);
  });
  return { emailQueueJob, overdueRemindersJob, billingLockJob, billingNotificationsJob, usageReminderJob, recurringInvoicesJob, recurringExpensesJob, hrAutomationJob };
}

// server/_core/index.ts
function isPortAvailable(port) {
  return new Promise((resolve5) => {
    const server = net.createServer();
    server.listen(port, () => {
      server.close(() => resolve5(true));
    });
    server.on("error", () => resolve5(false));
  });
}
async function findAvailablePort(startPort = 3e3) {
  for (let port = startPort; port < startPort + 20; port++) {
    if (await isPortAvailable(port)) {
      return port;
    }
  }
  throw new Error(`No available port found starting from ${startPort}`);
}
async function startServer() {
  const app = express2();
  app.set("trust proxy", 1);
  const server = createServer(app);
  console.log("[SCHEDULER] Initializing scheduled jobs...");
  const scheduledJobs = initializeScheduledJobs();
  console.log("[SCHEDULER] Initializing background schedulers...");
  const backgroundJobs = initializeSchedulers();
  app.use(compression({
    filter: (req, res) => {
      if (req.headers["x-no-compression"]) {
        return false;
      }
      return compression.filter(req, res);
    },
    level: 6
    // Balance between speed (6) and compression ratio
  }));
  app.use((0, import_cookie_parser.default)());
  app.use(express2.json({ limit: "50mb" }));
  app.use(express2.urlencoded({ limit: "50mb", extended: true }));
  app.use((req, res, next) => {
    const start = Date.now();
    metricsCollector.incrementConnections();
    res.on("finish", () => {
      metricsCollector.decrementConnections();
      metricsCollector.recordRequest(Date.now() - start, res.statusCode >= 400);
    });
    next();
  });
  app.use(createGlobalRateLimiter());
  app.use("/api/trpc", createTierRateLimiter());
  console.log(`[STARTUP] CSRF protection: DISABLED (using JWT token auth for APIs)`);
  app.use((req, res, next) => {
    for (const key in req.query) {
      if (typeof req.query[key] === "string") {
        req.query[key] = (0, import_sanitize_html.default)(req.query[key], { allowedTags: [], allowedAttributes: {} });
      }
    }
    next();
  });
  app.use((req, res, next) => {
    res.setHeader(
      "Content-Security-Policy",
      "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: https:; font-src 'self' data: https:; connect-src 'self' https: http://localhost:* ws://localhost:* wss://localhost:*; frame-ancestors 'none'; base-uri 'self'; form-action 'self';"
    );
    next();
  });
  app.use((req, res, next) => {
    if (req.session && req.session.user) {
      const now = Date.now();
      const last = req.session.lastActivity || now;
      if (now - last > 10 * 60 * 1e3) {
        delete req.session.user;
        return res.status(440).send({ message: "Logged out due to inactivity" });
      }
      req.session.lastActivity = now;
    }
    next();
  });
  registerOAuthRoutes(app);
  setupPaymentWebhooks(app);
  app.get("/api/sse/notifications", sseHandler);
  const uploadDir = process.env.UPLOAD_DIR || path6.resolve(process.cwd(), "uploads");
  if (!fs6.existsSync(uploadDir)) fs6.mkdirSync(uploadDir, { recursive: true });
  app.use("/uploads", express2.static(uploadDir));
  app.use("/api", (req, res, next) => {
    const originalJson = res.json;
    res.json = function(data) {
      if (data?.code || res.statusCode >= 400) {
        console.log(`[API ${req.method}] ${req.path} - Status: ${res.statusCode}`, data);
      }
      return originalJson.call(this, data);
    };
    next();
  });
  app.use(
    "/api/trpc",
    createExpressMiddleware({
      router: appRouter,
      createContext
    })
  );
  app.use((err, req, res, next) => {
    console.error("[Error Handler]", err);
    if (!res.headersSent) {
      const statusCode = err.statusCode || err.status || 500;
      const message2 = err.message || "Internal Server Error";
      if (req.path.startsWith("/api")) {
        res.status(statusCode).json({
          error: {
            code: "INTERNAL_SERVER_ERROR",
            message: message2,
            ...process.env.NODE_ENV === "development" && { stack: err.stack }
          }
        });
      } else {
        res.status(statusCode).send(`
          <!DOCTYPE html>
          <html>
            <head><title>Error ${statusCode}</title></head>
            <body>
              <h1>Error ${statusCode}</h1>
              <p>${message2}</p>
            </body>
          </html>
        `);
      }
    }
  });
  if (process.env.NODE_ENV === "development") {
    const viteMod = "./vite";
    const { setupVite } = await import(
      /* @vite-ignore */
      viteMod
    );
    await setupVite(app, server);
  } else {
    serveStatic(app);
  }
  const preferredPort = parseInt(process.env.PORT || "3000");
  const port = await findAvailablePort(preferredPort);
  if (port !== preferredPort) {
    console.log(`Port ${preferredPort} is busy, using port ${port} instead`);
  }
  server.listen(port, () => {
    console.log(`Server running on http://localhost:${port}/`);
  });
}
startServer().catch(console.error);
